---
import type { MuseumExhibitId } from '../../data/museumExhibits'
interface Props { exhibit: MuseumExhibitId }
const { exhibit } = Astro.props
const titleId = `viewer-exhibit-${exhibit}-title`
---
<svg class="museum-exhibit-art" viewBox="0 0 560 310" role="img" aria-labelledby={titleId}>
  <title id={titleId}>{exhibit === 'mln131' ? 'An editorial spread titled Dân chủ, with a conceptual chart and chapter markings.' : 'An editorial timeline spread marking Vietnam from 1945 to 1954.'}</title>
  <rect class="paper" x="24" y="20" width="512" height="270" />
  <path class="rule" d="M44 59h472M44 253h472" />
  <text class="label" x="44" y="45">{exhibit === 'mln131' ? 'MLN131 / DIGITAL EXHIBIT' : 'VNR202 / VIETNAM'}</text>
  {exhibit === 'mln131' ? <>
    <path class="rule" d="M280 59v194M303 86h190m-190 14h167m-167 14h180" />
    <text class="vietnamese" x="44" y="137" lang="vi">DÂN</text><text class="vietnamese" x="44" y="218" lang="vi">CHỦ</text>
    <path class="accent" d="M44 234h205" />
    <path class="rule" fill="none" d="M303 231v-91h190v91ZM315 218l35-38 32 20 29-46 24 27 42-29" />
    <text class="label" x="44" y="274">DEMOS + KRATOS / CONCEPTS TO CHAPTERS</text>
  </> : <>
    <text class="display" x="44" y="165">1945</text><text class="display" x="298" y="230">1954</text>
    <path class="accent" d="M44 234h213m26-147h210" />
    <path class="rule" d="M44 242v20m52-20v20m52-20v20m52-20v20m52-20v20m52-20v20m52-20v20m52-20v20m52-20v20m52-20v20" />
    <text class="label" x="44" y="278">HISTORY, IN MOTION / CHAPTERS THROUGH TIME</text>
  </>}
</svg>
<style lang="scss">
  .museum-exhibit-art {
    display: block; width: 100%; height: auto; color: color(secondary);
    .paper { fill: color(surface-raised); stroke: color(line); }
    .rule { stroke: color(secondary); stroke-width: 1; }
    .accent { stroke: #a44738; stroke-width: 4; }
    .label { fill: currentColor; font: 400 11px font-family(fraktion); }
    .vietnamese { fill: currentColor; font: 700 78px Arial, sans-serif; letter-spacing: -0.035em; }
    .display { fill: currentColor; font: 700 108px font-family(bigger); }
  }
</style>
