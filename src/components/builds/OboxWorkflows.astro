---
import { oboxWorkflows } from '../../data/oboxWorkflows'
import OboxWorkflowMap from './OboxWorkflowMap.astro'
---
<section class="project-content__section obox-flows" aria-labelledby="obox-workflows-title">
  <p class="project-content__label">02 / Follow a workflow</p><h4 id="obox-workflows-title">Trace an action through the system</h4>
  <div class="obox-flows__choices" role="group" aria-label="OboxSTEAM workflows">{oboxWorkflows.map((workflow, index) => <button type="button" data-workflow-select={workflow.id} aria-pressed={index === 0} aria-controls={`obox-workflow-${workflow.id}`}><span aria-hidden="true">0{index + 1}</span>{workflow.title}</button>)}</div>
  {oboxWorkflows.map((workflow, workflowIndex) => <section id={`obox-workflow-${workflow.id}`} data-workflow-panel={workflow.id} hidden={workflowIndex !== 0} aria-label={workflow.title}>
    <p class="obox-flows__introduction">{workflow.introduction}</p>
    <div class="obox-flows__layout">
      <div class="obox-flows__steps"><p class="project-content__label">Select a step</p><ol aria-label={`${workflow.title} steps`}>{workflow.steps.map((step, index) => <li><button type="button" data-workflow-step={index} data-step-workflow={workflow.id} aria-current={index === 0 ? 'step' : undefined} aria-controls={`obox-${workflow.id}-${step.id}`} aria-label={`Step ${index + 1}: ${step.title}`}><span aria-hidden="true">0{index + 1}</span>{step.title}<span class="obox-flows__step-mark" aria-hidden="true">↗</span></button></li>)}</ol></div>
      <div class="obox-flows__stage">
        <OboxWorkflowMap workflowId={workflow.id} />
        <div class="obox-flows__readout" aria-live="polite" aria-atomic="true">{workflow.steps.map((step, index) => <div id={`obox-${workflow.id}-${step.id}`} data-workflow-readout={index} hidden={index !== 0}><p class="project-content__label">Step {String(index + 1).padStart(2, '0')} / {String(workflow.steps.length).padStart(2, '0')}</p><h5>{step.title}</h5><p>{step.description}</p></div>)}</div>
        <div class="obox-flows__navigation" role="group" aria-label={`${workflow.title} step navigation`}><button type="button" data-step-direction="-1" disabled><span aria-hidden="true">←</span> Previous step</button><button type="button" data-step-direction="1">Next step <span aria-hidden="true">→</span></button></div>
      </div>
    </div>
    <aside class="obox-flows__takeaway" aria-label={`${workflow.title} takeaway`}><p class="project-content__label">What holds the flow together</p><p>{workflow.takeaway}</p></aside>
    <ul class="obox-flows__notes">{workflow.notes.map((note) => <li>{note}</li>)}</ul>
  </section>)}
</section>
<style lang="scss">
  .obox-flows {
    &__choices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; margin-top: 1.5rem; button { display: flex; align-items: center; gap: 0.75rem; text-align: left; min-height: 52px; padding: 0.75rem 1rem; border: 1px solid color(line); color: color(secondary); background: color(primary); cursor: pointer; font: 400 12px / 1.4 font-family(fraktion); span { color: color(muted); } &[aria-pressed='true'] { background: color(secondary); color: color(primary); span { color: inherit; } } } }
    &__introduction { margin-block: 1.5rem !important; max-width: 65ch; }
    &__layout { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 2rem; align-items: start; }
    &__steps { ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid color(line); } button { display: flex; align-items: center; gap: 0.75rem; width: 100%; min-height: 60px; text-align: left; padding: 1rem 0.75rem; border: 0; border-bottom: 1px solid color(line); color: color(muted); background: transparent; cursor: pointer; font: 400 12px / 1.45 font-family(fraktion); &[aria-current='step'] { color: color(secondary); background: color(surface); box-shadow: inset 3px 0 color(secondary); } &:hover { color: color(secondary); } } }
    &__step-mark { margin-left: auto; visibility: hidden; } button[aria-current='step'] &__step-mark { visibility: visible; }
    &__stage { min-width: 0; display: flex; flex-direction: column; }
    &__readout { min-height: 180px; padding-block: 1.5rem; h5 { margin: 0; font: 400 clamp(1.5rem, 2vw, 2rem) / 1.2 font-family(editorial); } }
    &__navigation { display: flex; justify-content: space-between; gap: 0.75rem; padding-top: 0.75rem; border-top: 1px solid color(line); button { min-height: 44px; display: flex; align-items: center; justify-content: center; gap: 0.75rem; padding: 0.75rem 1rem; border: 1px solid color(line); color: color(secondary); background: color(primary); cursor: pointer; font: 400 11px / 1.4 font-family(fraktion); &:hover:not(:disabled) { background: color(secondary); color: color(primary); } &:disabled { opacity: 0.4; cursor: default; } } }
    &__takeaway { margin-top: 2rem; border-left: 2px solid color(secondary); padding: 0.25rem 0 0.25rem 1.25rem; max-width: 65ch; p:not(.project-content__label) { font-size: clamp(1.35rem, 2vw, 1.7rem); } }
    &__notes { margin: 1.5rem 0 0; padding-left: 1.25rem; max-width: 75ch; color: color(muted); font: 400 1rem / 1.5 font-family(editorial); li + li { margin-top: 0.75rem; } }
    @media (max-width: 987px) { &__layout { grid-template-columns: 1fr; gap: 1.5rem; } &__steps ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); } &__steps button { height: 100%; } }
    @media (max-width: 767px) { &__choices { grid-template-columns: 1fr; button { min-height: 48px; } } &__steps button { gap: 0.5rem; font-size: 11px; padding: 0.75rem; } &__step-mark { display: none; } &__readout { min-height: 230px; order: -2; padding-top: 0; } &__navigation { order: -1; margin-bottom: 1.5rem; gap: 0.5rem; button { gap: 0.5rem; padding: 0.75rem; } } }
  }
</style>
