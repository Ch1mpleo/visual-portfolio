---
import ProjectLinks from './ProjectLinks.astro'
import type { ProjectLink } from '../../data/projects'
import type { Architecture } from '../../data/projectArchitectures'
import { infrastructureGeometry } from './infrastructure/geometry'
import '../../styles/components/infrastructure.scss'
interface Props { id: string; architecture: Architecture; links?: readonly ProjectLink[] }
const { id, architecture, links } = Astro.props
const drawing = infrastructureGeometry(architecture)
const panelId = (nodeId: string) => `arch-${id}-${nodeId}`
---
<section class="project-content arch-map" data-arch-map data-project-infra={id} data-default-node={architecture.defaultNode} data-world-width={architecture.width} data-world-height={architecture.height} aria-labelledby={`infra-heading-${id}`}>
  <header class="arch-map__intro">
    <p class="project-content__label">Built with</p>
    <h3 id={`infra-heading-${id}`}>{architecture.title}</h3>
    <p>{architecture.introduction}</p>
  </header>
  <figure class="infra-figure">
    <div class="infra-toolbar">
      <span class="infra-toolbar__identity"><span aria-hidden="true">◇</span> System anatomy</span>
      <button type="button" class="infra-play" data-infra-play aria-pressed="false"><span data-play-icon aria-hidden="true">↗</span><span data-play-label>Trace flow</span></button>
    </div>
    <div class="infra-viewport" data-infra-viewport role="group" aria-label="Interactive system anatomy. Select a part to see its stack.">
      <div class="infra-space" data-infra-space>
        <div class="infra-world" data-infra-world style={`width:${architecture.width}px;height:${architecture.height}px`}>
          <svg class="iso-svg infra-svg" viewBox={`0 0 ${architecture.width} ${architecture.height}`} width={architecture.width} height={architecture.height} aria-hidden="true">
            <defs><marker id={`infra-arrow-${id}`} viewBox="0 0 7 7" refX="6" refY="3.5" markerWidth="7" markerHeight="7" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 0L7 3.5L0 7Z" fill="var(--anatomy-mid)" /></marker></defs>
            <g class="infra-connections">
              {drawing.connections.map(edge => <g class="infra-trace" data-infra-edge={edge.id} data-from={edge.from} data-to={edge.to} data-label={edge.label}>
                <path class="infra-track" d={edge.d} marker-end={`url(#infra-arrow-${id})`} />
                <circle class="infra-contact" r="3" opacity="0" />
                <title>{edge.fromNode.label} → {edge.toNode.label}: {edge.label}</title>
              </g>)}
            </g>
            {drawing.devices.map(({ node, body }) => <g class="infra-device" data-infra-part={node.id} transform={`translate(${node.at[0]} ${node.at[1]})`}>
              <g class="infra-device__lift"><g class="infra-device__body" set:html={body} /></g>
            </g>)}
          </svg>
          {architecture.nodes.map(node => <button type="button" class="infra-node" style={`left:${node.at[0]}px;top:${node.at[1] - 112}px`} data-arch-select={node.id} data-x={node.at[0]} data-y={node.at[1]} data-kind={node.kind} aria-pressed="false" aria-expanded="false" aria-controls={panelId(node.id)}>
            <span class="infra-node__plate"><span class="infra-node__label">{node.label}<span class="infra-node__inspect" aria-hidden="true">+</span></span><span class="infra-node__stack">{node.stack}</span></span>
          </button>)}
        </div>
      </div>
    </div>
    <figcaption class="infra-caption"><span class="infra-caption__hint">Hover to peek · Click to stay a while</span><span data-infra-readout>Core parts, connected.</span></figcaption>
  </figure>
  <aside class="infra-bubble" data-infra-bubble hidden aria-label="Inside this part">
    <header class="infra-bubble__bar">
      <span class="infra-bubble__eyebrow"><span class="infra-bubble__spark" aria-hidden="true">✳</span> Inside the build</span>
      <div class="infra-bubble__actions">
        <button type="button" class="infra-bubble__pin" data-infra-pin aria-pressed="false" aria-label="Pin inspection">
          <span class="infra-bubble__pin-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6l-1 6 4 4v2H6v-2l4-4-1-6Z" /><path d="M12 15v6" /></svg></span>
          <span data-infra-pin-label>Pin</span>
        </button>
        <button type="button" class="infra-bubble__close" data-infra-close aria-label="Close inspection">×</button>
      </div>
    </header>
    <div class="infra-bubble__content">
      {architecture.nodes.map(node => <section id={panelId(node.id)} data-arch-panel={node.id} hidden>
        <h4 id={`${panelId(node.id)}-title`}>{node.label}</h4>
        <p class="infra-bubble__role">{node.role}</p>
        <ul class="infra-bubble__tools" aria-label={`${node.label} stack`}>{node.tools.map(tool => <li>{tool}</li>)}</ul>
        <div class="infra-bubble__detail"><p class="infra-bubble__eyebrow">The little details</p><p class="infra-bubble__note">{node.note}</p></div>
        <a class="infra-bubble__source" href={node.source} target="_blank" rel="noopener noreferrer">Peek at the source <span aria-hidden="true">↗</span></a>
      </section>)}
    </div>
  </aside>
  <span class="u-sr-only" data-infra-announcement aria-live="polite"></span>
  {links && <ProjectLinks links={links} />}
</section>
<script>
  import { InfrastructureController } from './infrastructure/InfrastructureController'
  document.querySelectorAll<HTMLElement>('[data-arch-map]').forEach(map => new InfrastructureController(map))
</script>
