---
import type { OboxChapterId } from '../../data/oboxChapters'
import { oboxEngineering } from '../../data/oboxEngineering'
import StoryAnnotation from './StoryAnnotation.astro'
import StoryConnection from './StoryConnection.astro'
interface Props { chapter: OboxChapterId }
const { chapter } = Astro.props
const parts = oboxEngineering.find((item) => item.id === chapter)!.parts
const descriptions = {
  curriculum: 'Author a curriculum blueprint, review it with experts, and publish an approved program.',
  learning: 'A connected class leads to mobile attendance and a lasting learning record.',
  portfolio: 'Personal highlights become an editable portfolio and a published student story.',
}
const transitions = {
  curriculum: ['revise together', 'ready to teach'],
  learning: ['join a session', 'capture progress'],
  portfolio: ['make it yours', 'put it out there'],
}
---
<svg class="obox-story-art" viewBox="0 0 1200 590" role="group" aria-label={descriptions[chapter]}>
  <path class="art-grid" d="M0 104H1200M0 208H1200M0 312H1200M0 416H1200M100 0V520M200 0V520M300 0V520M400 0V520M500 0V520M600 0V520M700 0V520M800 0V520M900 0V520M1000 0V520M1100 0V520" />
  <StoryConnection path="M346 142C381 142 369 56 421 56S460 92 496 102" label={transitions[chapter][0]} x={423} y={33} />
  <StoryConnection path="M726 325C776 325 758 405 809 405S846 340 879 329" label={transitions[chapter][1]} x={804} y={433} delay={-2} />
  {parts.map((part, index) => <g class:list={['art-object', { 'is-selected': index === 0 }]} data-story-object={part.id} role="button" tabindex="0" aria-label={`Inspect ${part.label}`} aria-pressed={index === 0} aria-controls={`obox-note-${part.id}`}>
    <rect class="art-hit" x={index * 400 + 14} y="14" width="372" height="564" rx="2" />
    <g class="art-drawing">
      {part.id === 'blueprint' && <g transform="translate(94 55) rotate(-5 150 180)">
        <rect class="art-shadow" x="16" y="18" width="292" height="342" />
        <rect class="art-paper" x="10" y="9" width="292" height="342" /><rect class="art-paper" width="292" height="342" />
        <text class="art-kicker" x="24" y="35">CURRICULUM / DRAFT</text><path class="art-line" d="M24 53H268M45 86V290" />
        {[0,1,2].map((i) => <g transform={`translate(70 ${81 + i * 77})`}><rect class:list={[i === 0 ? 'art-highlight' : 'art-soft']} width="191" height="59" /><path class="art-line" d="M18 21H151M18 38H112" /><circle class="art-dot" cx="-25" cy="29" r="5" /><path class="art-line" d="M-25 29H0" /></g>)}
        <text class="art-small" x="24" y="319">MODULES → COURSES → ACTIVITIES</text>
      </g>}
      {part.id === 'review' && <g transform="translate(475 101) rotate(4 131 135)">
        <rect class="art-shadow" x="10" y="10" width="258" height="273" /><rect class="art-paper" width="258" height="273" />
        <path class="art-soft" d="M60 -12H199V18H60Z" /><text class="art-kicker" x="24" y="49">EXPERT / REVIEW</text>
        <path class="art-line" d="M24 68H234M24 99H207M24 122H223M24 145H174M24 204H215M24 227H163" />
        <path class="art-accent-line" d="M18 132L230 111M156 149Q208 130 236 158" />
        <circle class="art-highlight" cx="211" cy="195" r="32" /><path class="art-accent-line" d="M194 195L206 207L230 180" />
        <g transform="translate(-24 183) rotate(-10)"><rect class="art-soft" width="115" height="72" /><path class="art-line" d="M15 21H99M15 38H77M15 55H89" /></g>
      </g>}
      {part.id === 'release' && <g transform="translate(877 73) rotate(5 109 163)">
        <rect class="art-shadow" x="12" y="15" width="218" height="326" /><rect class="art-paper" width="218" height="326" /><rect class="art-ink" width="26" height="326" />
        <text class="art-display" x="48" y="79">OBOX</text><text class="art-display" x="48" y="126">STEAM</text>
        <path class="art-line" d="M48 154H191M48 176H151" />
        <circle class="art-stamp" cx="123" cy="247" r="46" /><circle class="art-accent-line" cx="123" cy="247" r="37" /><path class="art-accent-line" d="M104 246L118 260L143 232" />
        <text class="art-small" x="52" y="311">APPROVED / PUBLISHED</text>
      </g>}
      {part.id === 'class' && <g transform="translate(75 104) rotate(-4 154 132)">
        <rect class="art-shadow" x="12" y="14" width="310" height="269" /><rect class="art-paper" width="310" height="269" />
        <rect class="art-ink" width="310" height="42" /><circle class="art-on-ink" cx="22" cy="21" r="4" /><circle class="art-on-ink" cx="39" cy="21" r="4" />
        <text class="art-kicker" x="24" y="78">CLASS / SMART CITY LAB</text><path class="art-line" d="M24 99H286" />
        {[0,1,2,3].map((i) => <g transform={`translate(${24 + i * 66} 121)`}><rect class="art-soft" width="57" height="53" /><text class="art-small" x="18" y="32">0{i + 1}</text></g>)}
        <path class="art-line" d="M24 204H250M24 225H181" /><circle class="art-stamp" cx="266" cy="247" r="31" /><path class="art-accent-line" d="M251 247L261 258L280 236" />
      </g>}
      {part.id === 'activity' && <g transform="translate(513 51) rotate(4 89 180)">
        <rect class="art-shadow" x="12" y="14" width="183" height="367" rx="27" /><rect class="art-ink" width="183" height="367" rx="27" /><rect class="art-paper" x="8" y="8" width="167" height="351" rx="21" />
        <rect class="art-ink" x="62" y="16" width="60" height="11" rx="5" /><text class="art-kicker" x="24" y="66">SESSION / QR</text>
        <path class="art-heavy" d="M32 111H66V145H32ZM117 111H151V145H117ZM32 196H66V230H32Z" /><path class="art-heavy" d="M84 111V136H99V170H130M32 169H65V185M85 195H99V224H151M143 161V181H154M85 157V177M126 203V216" />
        <rect class="art-highlight" x="22" y="274" width="139" height="47" rx="4" /><path class="art-accent-line" d="M47 297L55 305L70 287" /><text class="art-small" x="80" y="302">CHECK IN</text>
        <path class="art-line" d="M69 342H114" />
      </g>}
      {part.id === 'evidence' && <g transform="translate(834 112) rotate(-5 131 147)">
        <rect class="art-paper" x="28" y="-12" width="227" height="262" /><text class="art-kicker" x="48" y="23">LEARNING / EVIDENCE</text><path class="art-line" d="M48 46H229M48 68H194M48 90H212" />
        <path class="art-soft" d="M0 93H115L132 117H281V282H0Z" /><path class="art-paper" d="M0 133H281L257 307H-21Z" />
        <path class="art-accent-line" d="M38 239L79 201L119 243L180 176L229 218" /><circle class="art-highlight" cx="180" cy="176" r="8" />
        <text class="art-small" x="41" y="284">A RECORD OF GROWTH</text>
      </g>}
      {part.id === 'media' && <g transform="translate(59 152) rotate(-7 164 102)">
        <rect class="art-ink" width="329" height="205" />
        {Array.from({length: 10}, (_, i) => <><rect class="art-on-ink" x={13 + i * 31} y="10" width="16" height="10" /><rect class="art-on-ink" x={13 + i * 31} y="184" width="16" height="10" /></>)}
        <rect class="art-paper" x="16" y="32" width="141" height="139" /><rect class="art-paper" x="172" y="32" width="141" height="139" />
        <circle class="art-soft" cx="86" cy="75" r="24" /><path class="art-line" d="M42 151Q47 102 86 105Q124 98 137 151M187 139L216 91L248 123L290 67" /><rect class="art-accent-line" x="52" y="43" width="67" height="66" rx="4" />
        <path class="art-accent-line" d="M185 155H300" />
      </g>}
      {part.id === 'draft' && <g transform="translate(450 56) rotate(-2 161 180)">
        <rect class="art-shadow" x="12" y="15" width="316" height="358" /><rect class="art-paper" width="316" height="358" />
        <path class="art-line" d="M0 38H316M65 38V358M14 75H48M14 96H41M14 117H48M14 140H40" /><text class="art-kicker" x="17" y="26">PORTFOLIO / BUILDER</text>
        <circle class="art-highlight" cx="28" cy="191" r="11" /><circle class="art-dot" cx="49" cy="191" r="5" />
        <rect class="art-soft" x="85" y="61" width="211" height="85" /><circle class="art-paper" cx="122" cy="103" r="25" /><path class="art-line" d="M164 88H277M164 112H240M85 173H295M85 196H231" />
        <rect class="art-paper" x="85" y="222" width="99" height="111" /><rect class="art-paper" x="198" y="222" width="98" height="111" /><path class="art-line" d="M101 243H167M101 265H151M214 243H279M214 265H261" /><path class="art-accent-line" d="M273 140L281 165L288 155L302 152Z" />
      </g>}
      {part.id === 'publish' && <g transform="translate(893 72) rotate(5 99 158)">
        <rect class="art-ink" width="204" height="319" /><rect class="art-soft" x="13" y="14" width="178" height="50" />
        <text class="art-display art-inverse" x="19" y="114">MY STORY.</text><path class="art-inverse-line" d="M19 137H170M19 157H138" />
        <rect class="art-paper" x="19" y="184" width="77" height="93" /><rect class="art-paper" x="110" y="184" width="76" height="93" />
        <g transform="translate(-50 270) rotate(-12 111 48)"><rect class="art-paper" width="222" height="101" /><path class="art-line" d="M18 25H150M18 46H104M18 71H121" /><circle class="art-stamp" cx="178" cy="53" r="26" /><path class="art-accent-line" d="M165 52L175 62L191 43" /></g>
      </g>}
    </g>
    <StoryAnnotation id={part.id} index={index} label={part.label} x={index * 400 + 28} y={458} width={344} />
  </g>)}
</svg>
<style lang="scss">
  .obox-story-art { display: block; width: 100%; height: auto; color: color(secondary);
    .art-grid { fill: none; stroke: color(line); opacity: .18; stroke-width: .7; }
    .art-paper { fill: color(primary); stroke: currentColor; stroke-width: 1.5; }
    .art-line { fill: none; stroke: currentColor; stroke-width: 1.5; }
    .art-heavy { fill: none; stroke: currentColor; stroke-width: 4; }
    .art-ink, .art-dot { fill: color(secondary); }
    .art-on-ink { fill: color(primary); }
    .art-shadow { fill: color(secondary); opacity: .12; }
    .art-soft { fill: color(surface-raised); stroke: color(secondary); stroke-width: 1.5; }
    .art-highlight { fill: color(accent); fill-opacity: .16; stroke: color(accent); stroke-width: 1.5; }
    .art-accent-line, .art-stamp { fill: none; stroke: color(accent); stroke-width: 2.5; }
    .art-inverse-line { fill: none; stroke: color(primary); stroke-width: 1.5; }
    text { fill: currentColor; font: 400 13px font-family(fraktion); letter-spacing: .02em; }
    .art-small { font-size: 11px; }
    .art-display { font: 700 45px font-family(bigger); }
    .art-display.art-inverse { fill: color(primary); }
    .art-hit { fill: transparent; stroke: transparent; stroke-width: 1; }
    .art-object { cursor: pointer; outline: none; }
    .art-drawing { opacity: .66; translate: 0 0; transition: opacity .35s, translate .55s cubic-bezier(.22, 1, .36, 1); }
    .art-object:is(:hover, :focus-visible) .art-drawing { opacity: .9; }
    .art-object.is-selected .art-drawing { opacity: 1; translate: 0 -9px; }
    .art-object:focus-visible .art-hit { stroke: color(accent); stroke-dasharray: 4 5; }
    @media (prefers-reduced-motion: reduce) { .art-drawing { transition: none; translate: none !important; } }
  }
</style>
