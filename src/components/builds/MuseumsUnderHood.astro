---
import { museumExhibits } from '../../data/museumExhibits'
import { museumLayers } from '../../data/projectInteriors'
import MuseumLayerArtwork from './MuseumLayerArtwork.astro'
---
<div class="project-content">
  <p class="project-content__label">Interactive Museums / Under the Hood</p><h3>Content becomes<br />an experience.</h3>
  <p class="project-content__intro">Three layers turn coursework into a place to explore: the story’s structure, its visual language, and the interaction guiding the reader.</p>
  <div class="project-content__exhibit-controls" role="group" aria-label="Choose an exhibit for the breakdown">{museumExhibits.map((exhibit, index) => <button type="button" data-exhibit={exhibit.id} aria-pressed={index === 0} aria-controls={`exhibit-hood-${exhibit.id}`}>{exhibit.label}</button>)}</div>
  <div class="interior-selectors" role="group" aria-label="Museum editorial layers">{museumLayers.map((layer, index) => <button type="button" data-museum-layer={layer.id} aria-pressed={index === 0} aria-controls={`museum-layer-${layer.id}`}><span aria-hidden="true">0{index + 1}</span>{layer.label}</button>)}</div>
  <div class="interior-study">
    <div>{museumExhibits.map((exhibit, index) => <figure id={`exhibit-hood-${exhibit.id}`} data-exhibit-panel={exhibit.id} hidden={index !== 0}><MuseumLayerArtwork exhibit={exhibit.id} /><figcaption>{exhibit.label} / illustrated editorial layers</figcaption></figure>)}</div>
    <div>{museumLayers.map((layer, index) => <section id={`museum-layer-${layer.id}`} data-museum-layer-panel={layer.id} hidden={index !== 0}><p class="project-content__label">Layer 0{index + 1} / 03</p><h4>{layer.label}</h4><p>{layer.description}</p></section>)}</div>
  </div>
  <section class="project-content__section"><p class="project-content__label">Shared stack</p><h4>Structure, styling, and motion</h4><p>React and TypeScript shape the interfaces; Vite supports the build, Tailwind the styling, and GSAP and Motion the reveals and transitions.</p><p class="project-content__note">Each exhibit has its own chapters and visual rhythm. Select an exhibit in either tab to keep exploring the same one.</p></section>
</div>
