---
import { Code } from 'astro:components'
import cutout from '../../../public/components/cutout.html?raw'
import emulsion from '../../../public/components/emulsion.html?raw'
import reverie from '../../../public/components/reverie.html?raw'
import { splitComponentSource } from '../../utils/component-source.mjs'
export function getStaticPaths() {
  return Object.entries({ cutout, emulsion, reverie }).map(([id, source]) => ({ params: { id }, props: { source, id } }))
}
const { source, id } = Astro.props
const files = splitComponentSource(source, id)
---
{Object.entries(files).map(([language, code]) => <section data-source-part={language}><Code code={code} lang={language === 'js' ? 'javascript' : language} theme="github-dark" /></section>)}
<script is:inline type="application/json" data-component-files set:html={JSON.stringify(files).replace(/</g, '\\u003c')} />
