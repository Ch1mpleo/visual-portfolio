---
import LucideIcon from './experiments/LucideIcon.astro'
const clarityId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID || ''
---

<aside class="recording-preferences" data-recording-preferences data-clarity-id={clarityId} data-production={String(import.meta.env.PROD)} hidden aria-label="Session recording preferences">
  <div class="recording-preferences__panel" id="recording-preferences-panel" role="region" aria-labelledby="recording-preferences-title" data-recording-panel data-lenis-prevent hidden>
    <div class="recording-preferences__head">
      <span class="recording-preferences__eyebrow">Privacy preferences</span>
      <button class="recording-preferences__close" type="button" data-recording-close aria-label="Close privacy preferences"><LucideIcon name="x" /></button>
    </div>
    <h2 id="recording-preferences-title">Your visit, your call.</h2>
    <p class="recording-preferences__description">Optional click heatmaps and session recordings help me improve this playground.</p>
    <p class="recording-preferences__note">Input fields stay masked. Basic Google Analytics visitor counts and click events are separate.</p>
    <div class="recording-preferences__actions">
      <button type="button" data-recording-allow>Allow recording</button>
      <button type="button" data-recording-deny>Keep it off</button>
    </div>
    <div class="recording-preferences__foot">
      <span class="recording-preferences__status"><i class="recording-preferences__dot" aria-hidden="true"></i><span data-recording-status aria-live="polite">Recording off</span></span>
      <a href="https://privacy.microsoft.com/privacystatement" target="_blank" rel="noopener noreferrer">Clarity privacy <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <button class="recording-preferences__toggle" type="button" data-recording-toggle aria-label="Privacy preferences. Recording is off." aria-controls="recording-preferences-panel" aria-expanded="false">
    <svg class="recording-preferences__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h5m4 0h7M4 17h9m4 0h3" /><circle cx="11" cy="7" r="2" /><circle cx="15" cy="17" r="2" /></svg>
    <span>Privacy</span>
    <span class="recording-preferences__toggle-state" data-recording-toggle-state>Off</span>
    <svg class="recording-preferences__chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="m4 10 4-4 4 4" /></svg>
  </button>
</aside>

<script>
  import { startAnalytics, installInteractionTracking } from '../utils/analytics'
  import { installRecordingPreferences } from '../utils/recording-consent'
  const root = document.querySelector<HTMLElement>('[data-recording-preferences]')!
  const enabled = startAnalytics(root.dataset.production === 'true', 'G-RH2J4YXLP3')
  if (enabled) installInteractionTracking()
  installRecordingPreferences(root, enabled)
</script>

<style lang="scss">
  .recording-preferences {
    --privacy-ease: cubic-bezier(.22, 1, .36, 1);
    position: fixed; z-index: 40;
    left: max(1rem, env(safe-area-inset-left)); bottom: max(1rem, env(safe-area-inset-bottom));
    display: flex; flex-direction: column; align-items: flex-start; gap: .65rem;
    color: color(secondary);
    &[hidden], [hidden] { display: none !important; }
    button, a { color: inherit; -webkit-tap-highlight-color: transparent; }
    button {
      min-height: 44px; border: 1px solid color(line); border-radius: 0;
      background: color(primary); cursor: pointer;
      font: 400 12px / 1.4 font-family(fraktion);
      transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
    }
    button:focus-visible, a:focus-visible { outline: 2px solid color(accent); outline-offset: 4px; }
    &__toggle {
      display: flex; align-items: center; gap: .65rem; padding: .6rem .8rem;
      box-shadow: 0 2px 12px rgb(0 0 0 / .06);
      transition: transform 240ms var(--privacy-ease), background 180ms ease, border-color 180ms ease;
      &:hover, &[aria-expanded='true'] { border-color: color(secondary); background: color(surface-raised); }
    }
    &__icon { width: 17px; height: 17px; flex-shrink: 0; }
    &__toggle-state { padding-left: .65rem; border-left: 1px solid color(line); color: color(muted); font-size: 11px; }
    &__chevron { width: 14px; height: 14px; color: color(muted); transition: transform 240ms var(--privacy-ease); }
    &__toggle[aria-expanded='true'] &__chevron { transform: rotate(180deg); }
    &__panel {
      width: min(370px, calc(100vw - 2rem)); max-height: calc(100dvh - 6rem);
      overflow-y: auto; overscroll-behavior: contain;
      padding: 1.25rem; border: 1px solid color(line); background: color(primary);
      box-shadow: 0 12px 36px rgb(0 0 0 / .12); transform-origin: bottom left;
      animation: privacy-reveal 260ms var(--privacy-ease);
    }
    &__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    &__eyebrow { font: 400 10px / 1.4 font-family(fraktion); text-transform: uppercase; letter-spacing: .075em; color: color(muted); }
    button.recording-preferences__close {
      display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0;
      margin: -.5rem -.5rem -.5rem 0; padding: 0; border-color: transparent; background: transparent; font-size: 18px;
      &:hover { background: color(surface-raised); border-color: color(line); }
    }
    h2 { margin: 1rem 0 .8rem; font: 400 30px / 1.1 font-family(editorial); letter-spacing: -.025em; }
    &__description { margin: 0; font: 400 17px / 1.5 font-family(editorial); letter-spacing: .005em; }
    &__note { margin: .8rem 0 1.25rem; color: color(muted); font: 400 14px / 1.5 font-family(editorial); letter-spacing: .005em; }
    &__actions {
      display: grid; grid-template-columns: 1fr 1fr; gap: .5rem;
      button { padding: .75rem .4rem; }
      [data-recording-allow] { color: color(primary); background: color(secondary); border-color: color(secondary); }
      [data-recording-allow]:hover { opacity: .85; }
      [data-recording-deny]:hover { border-color: color(secondary); background: color(surface-raised); }
    }
    &__foot {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .65rem;
      margin-top: 1rem; padding-top: .9rem; border-top: 1px solid color(line);
      color: color(muted); font: 400 10px / 1.5 font-family(fraktion);
      a { text-underline-offset: 3px; }
    }
    &__status { display: inline-flex; align-items: center; gap: .4rem; }
    &__dot { width: 6px; height: 6px; border: 1px solid currentColor; border-radius: 50%; }
    &[data-recording-state='allowed'] &__dot { color: color(accent); background: currentColor; }
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      &__toggle:hover { transform: translateY(-2px); }
      &__toggle:active { transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      &, *, *::before, *::after { animation: none !important; transition: none !important; }
    }
  }
  @keyframes privacy-reveal {
    from { opacity: 0; transform: translateY(10px) scale(.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  :global(html.is-project-viewer-open) .recording-preferences { visibility: hidden; }
</style>
