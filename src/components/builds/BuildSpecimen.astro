---
import type { Project } from '../../data/projects'
import ProjectArtwork from './ProjectArtwork.astro'

interface Props { project: Project }
const { project } = Astro.props
---

<article class:list={['build-specimen', `build-specimen--${project.id}`]} aria-labelledby={`build-${project.id}-title`} data-project-id={project.id}>
  <div class="build-specimen__meta">
    <span>{project.index} / {project.category}</span>
    <span aria-hidden="true">{project.id === 'oboxsteam' ? 'API + WEB + MOBILE' : project.id === 'graphpaper' ? 'DOCUMENT → GRAPH' : 'TWO EXHIBITS'}</span>
  </div>
  <div class="build-specimen__art">
    <ProjectArtwork projectId={project.id} description={project.artworkDescription} />
  </div>
  <div class="build-specimen__caption">
    <div>
      <h3 id={`build-${project.id}-title`}>{project.title}</h3>
      <p>{project.summary}</p>
    </div>
    <!-- Packet 2 will turn the specimen into an inspection trigger. -->
    <span class="build-specimen__inspect">Inspect project <span aria-hidden="true">↗</span></span>
  </div>
</article>

<style lang="scss">
  .build-specimen {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid color(line);
    background: color(surface);

    &--oboxsteam { grid-column: 1 / 8; grid-row: 1 / 3; }
    &--graphpaper { grid-column: 8 / 13; grid-row: 1; }
    &--museums { grid-column: 8 / 13; grid-row: 2; }

    &__meta {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid color(line);
      color: color(muted);
      font: 400 10px / 1.4 font-family(fraktion);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    &__art {
      display: flex;
      align-items: center;
      flex: 1;
      padding: 0.5rem 1rem;
      min-height: 180px;
      :global(.project-art) { height: auto; }
    }

    &--oboxsteam &__art { padding: 1.25rem; min-height: 370px; }

    &__caption {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.25rem;
      border-top: 1px solid color(line);
    }

    h3 {
      margin: 0;
      font: 700 clamp(1.8rem, 2.8vw, 2.7rem) / 1 font-family(bigger);
      text-transform: uppercase;
      letter-spacing: 0.005em;
    }

    p { margin: 0.5rem 0 0; max-width: 36ch; font: 400 1.125rem / 1.4 font-family(editorial); }

    &__inspect {
      display: inline-flex;
      gap: 0.75rem;
      align-items: center;
      color: color(muted);
      font: 400 11px / 1.4 font-family(fraktion);
      text-transform: uppercase;
      letter-spacing: 0.035em;
      > span { font-size: 18px; line-height: 1; }
    }

    &--oboxsteam h3 { font-size: clamp(3rem, 5.5vw, 5.25rem); }
    &--oboxsteam p { font-size: 1.35rem; }
    &--oboxsteam &__caption { padding: 1.5rem; gap: 1.5rem; }

    @media (min-width: 768px) and (max-width: 987px) {
      &--oboxsteam { grid-column: 1 / -1; grid-row: 1; }
      &--graphpaper { grid-column: 1; grid-row: 2; }
      &--museums { grid-column: 2; grid-row: 2; }
      &--oboxsteam &__art { padding: 1rem 12%; min-height: 0; }
    }

    @media (max-width: 767px) {
      &--oboxsteam, &--graphpaper, &--museums { grid-column: auto; grid-row: auto; }
      &__meta { padding: 0.875rem 1rem; font-size: 10px; }
      &__meta > span:last-child { display: none; }
      &__art, &--oboxsteam &__art {
        padding: 0.75rem;
        min-height: 0;
        aspect-ratio: 4 / 3;
        :global(.project-art) { height: 100%; object-fit: contain; }
      }
      &__caption, &--oboxsteam &__caption { padding: 1.25rem 1rem; gap: 1rem; }
      h3, &--oboxsteam h3 { font-size: clamp(2rem, 8vw, 3rem); }
      p, &--oboxsteam p { font-size: 1.125rem; }
    }
  }
</style>
