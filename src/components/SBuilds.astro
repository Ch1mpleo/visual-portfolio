---
import { projects } from '../data/projects'
import BuildSpecimen from './builds/BuildSpecimen.astro'
---

<section id="builds" class="s-builds" aria-labelledby="builds-title">
  <div class="s-builds__intro">
    <p class="s-builds__eyebrow">03 / Selected builds</p>
    <div class="s-builds__heading">
      <h2 id="builds-title">Things<br />I've built<span class="s-builds__period">.</span></h2>
      <p class="s-builds__description">Products, experiments, and places to explore. Open a project to see how it works.</p>
    </div>
  </div>
  <div class="s-builds__gallery">
    {projects.map((project) => <BuildSpecimen project={project} />)}
  </div>
  <div class="s-builds__footnote" aria-hidden="true"><span>Selected work / 01 — 03</span><span>Built with curiosity.</span></div>
</section>

<script>
  import { revealBuilds } from './builds/GalleryMotion'
  const gallery = document.querySelector<HTMLElement>('.s-builds__gallery')
  if (gallery) revealBuilds(gallery)
</script>

<style lang="scss">
  .s-builds {
    position: relative;
    padding: clamp(4rem, 7vw, 6rem) clamp(1rem, 3.5vw, 4rem);
    color: color(secondary);
    background: color(primary);
    scroll-margin-top: 1.5rem;

    &__intro, &__gallery, &__footnote { max-width: 1560px; margin-inline: auto; }
    &__eyebrow { margin: 0 0 1.5rem; font: 400 12px / 1.4 font-family(fraktion); text-transform: uppercase; letter-spacing: 0.08em; }
    &__heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; margin-bottom: 2.5rem; }
    h2 { margin: 0; font: 700 clamp(4rem, 8.8vw, 9rem) / 0.88 font-family(bigger); text-transform: uppercase; letter-spacing: -0.01em; }
    &__period { color: color(accent); }
    &__description { margin: 0 0 0.3rem; max-width: 27ch; font: 400 clamp(1.25rem, 1.7vw, 1.6rem) / 1.4 font-family(editorial); }
    &__gallery { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(clamp(250px, 24vw, 340px), auto)); gap: 24px; }
    &__footnote { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1rem; color: color(muted); font: 400 10px / 1.4 font-family(fraktion); letter-spacing: 0.04em; text-transform: uppercase; }

    @media (min-width: 768px) and (max-width: 987px) {
      &__gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: auto; gap: 20px; }
    }
    @media (max-width: 767px) {
      padding: 3.5rem 1rem;
      &__heading { display: block; margin-bottom: 2rem; }
      h2 { font-size: clamp(3.5rem, 14vw, 6.5rem); }
      &__description { margin-top: 1.5rem; max-width: 30ch; font-size: 1.25rem; }
      &__gallery { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; gap: 16px; }
      &__footnote { flex-wrap: wrap; }
    }
  }
</style>
