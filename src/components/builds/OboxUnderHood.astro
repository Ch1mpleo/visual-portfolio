---
import { oboxChapters } from '../../data/oboxChapters'
import { oboxEngineering } from '../../data/oboxEngineering'
import OboxStoryArtwork from './OboxStoryArtwork.astro'
---
<div class="project-content obox-detail obox-engine" data-obox-engine>
  <header class="obox-intro">
    <div><p class="project-content__label">OboxSTEAM / Under the Hood</p><h3>One system.<br />Every stage connected.</h3></div>
    <p class="project-content__intro">The same shared foundation carries a program from its first blueprint to a student's published story. Select an object to look inside.</p>
  </header>
  <div class="obox-chapter-nav" role="group" aria-label="Engineering chapters">
    {oboxChapters.map((chapter) => <button type="button" data-obox-engine-chapter={chapter.id} aria-pressed={chapter.id === 'curriculum'} aria-controls={`obox-engine-${chapter.id}`}><span>{chapter.number}</span><strong>{chapter.label}</strong><span aria-hidden="true">↗</span></button>)}
  </div>
  {oboxEngineering.map((chapter) => <section id={`obox-engine-${chapter.id}`} data-obox-engine-panel={chapter.id} hidden={chapter.id !== 'curriculum'} aria-label={chapter.title}>
    <div class="obox-engine__heading"><h4>{chapter.title}</h4><span>{chapter.caption}</span></div>
    <div class="obox-engine__stage">
      <OboxStoryArtwork chapter={chapter.id} />
      <div class="obox-engine__objects" role="group" aria-label={`${chapter.title} objects`}>
        {chapter.parts.map((part, index) => <button type="button" data-obox-part={part.id} aria-pressed={index === 0} aria-controls={`obox-note-${part.id}`}><span aria-hidden="true">0{index + 1} / </span>{part.label}<span aria-hidden="true"> +</span></button>)}
      </div>
    </div>
    <div class="obox-engine__readout" aria-live="polite" aria-atomic="true">
      {chapter.parts.map((part, index) => <section id={`obox-note-${part.id}`} data-obox-part-panel={part.id} hidden={index !== 0} aria-label={part.title}>
        <div><p class="project-content__label">Inside / {part.label}</p><h4>{part.title}</h4></div>
        <div><p>{part.text}</p></div>
      </section>)}
    </div>
  </section>)}
  <aside class="obox-foundation" aria-label="Shared system foundation">
    <div><p class="project-content__label">Shared foundation</p><p>Web & mobile<br /><span>Role-specific experiences</span></p></div>
    <div class="obox-foundation__core"><span>HTTP boundary</span><span>Application services</span><span>Domain rules</span></div>
    <div><p class="project-content__label">API owns the records</p><p>Learning records<br /><span>Media stored separately</span></p></div>
  </aside>
  <details class="obox-delivery" data-obox-decision><summary>Shipping & observing the system<span aria-hidden="true">+</span></summary><p>A deployment pipeline builds and ships the backend as a container. Distributed tracing follows requests through the system; hosted workers handle scheduled tasks and media generation.</p></details>
</div>
