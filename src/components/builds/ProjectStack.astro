---
import ProjectLinks from './ProjectLinks.astro'
import type { Project } from '../../data/projects'
import { projectStacks, type ProjectStack } from '../../data/projectStacks'
interface Props { project: Project }
const { project } = Astro.props
const stack: ProjectStack = projectStacks[project.id]
---
<div class="project-content project-stack">
  <header class="project-stack__intro">
    <h3>Built with.</h3>
  </header>
  <div class="project-stack__groups">
    {stack.groups.map((group, index) => <section class="project-stack__group" aria-labelledby={`stack-${project.id}-${index}`}>
      <div class="project-stack__body">
        <div>
        <h4 id={`stack-${project.id}-${index}`}>{group.label}</h4>
        <p class="project-stack__purpose">{group.purpose}</p>
        </div>
        <ul aria-label={`${group.label} technologies`}>{group.tools.map((tool) => <li>{tool}</li>)}</ul>
      </div>
    </section>)}
  </div>
  {project.id !== 'museums' && <ProjectLinks links={project.links} />}
</div>
<style lang="scss">
  .project-stack {
    border-top: 1px solid color(line);
    &__intro { margin-bottom: 2rem; h3 { font-size: 2.5rem; } }
    &__group { padding-block: 1.25rem; border-top: 1px solid color(line); }
    &__body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem; align-items: center; h4 { margin: 0 0 .5rem; font: 400 1.5rem / 1.15 font-family(editorial); } }
    p.project-stack__purpose { margin: 0; color: color(muted); font: 400 18px / 1.5 font-family(editorial); max-width: 45ch; }
    ul { display: flex; flex-wrap: wrap; gap: .35rem .75rem; list-style: none; padding: 0; margin: 0; }
    li { font: 400 12px / 1.7 font-family(fraktion); overflow-wrap: anywhere; &:not(:last-child)::after { content: '·'; margin-left: .75rem; color: color(muted); } }
    @media (max-width: 767px) {
      &__body { grid-template-columns: 1fr; gap: 1rem; }
    }
  }
</style>
