---
import type { ProjectLink } from '../../data/projects'
interface Props { links: readonly ProjectLink[] }
const { links } = Astro.props
const showcases = links.filter((link) => new URL(link.href).hostname !== 'github.com')
const sources = links.filter((link) => new URL(link.href).hostname === 'github.com')
---
<nav class:list={['project-actions', { 'project-actions--source-only': showcases.length === 0 }]} aria-label="Project destinations">
  {showcases.map((link) => <a class="project-actions__showcase" href={link.href} target="_blank" rel="noopener noreferrer">
    <span class="project-actions__symbol" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><rect x="4" y="6" width="24" height="20" rx="2" /><path d="M4 12H28M8 9H9M12 9H13M14 17L18 20L14 23" /></svg></span>
    <span class="project-actions__copy"><span class="project-actions__eyebrow">Live experience</span><strong>{link.label === 'Website' ? 'Visit website' : link.label}</strong></span>
    <span class="project-actions__arrow" aria-hidden="true">↗</span><span class="u-sr-only"> (opens in a new tab)</span>
  </a>)}
  {sources.length > 0 && <div class="project-actions__sources">
    {sources.map((link) => <a class="project-actions__source" href={link.href} target="_blank" rel="noopener noreferrer">
      <svg class="project-actions__github" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.77-.24.77-.54v-2.08c-3.14.68-3.8-1.34-3.8-1.34-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.51-.28-5.15-1.26-5.15-5.58 0-1.23.44-2.24 1.16-3.03-.12-.29-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.15a10.6 10.6 0 0 1 5.62 0c2.14-1.45 3.08-1.15 3.08-1.15.62 1.55.24 2.7.12 2.98.72.79 1.15 1.8 1.15 3.03 0 4.33-2.64 5.3-5.16 5.58.4.35.76 1.03.76 2.08v3.09c0 .3.2.65.78.54A11.2 11.2 0 0 0 12 .8Z" /></svg>
      <span class="project-actions__copy"><span class="project-actions__eyebrow">GitHub repository</span><strong>{link.label}</strong></span>
      <span class="project-actions__arrow" aria-hidden="true">↗</span><span class="u-sr-only"> (opens in a new tab)</span>
    </a>)}
  </div>}
</nav>

<style lang="scss">
  .project-actions {
    display: grid; gap: .75rem; margin-top: 2rem;
    a { display: flex; align-items: center; gap: 1rem; min-width: 0; min-height: 88px; padding: 1rem 1.25rem; border: 1px solid color(line); text-decoration: none; transition: background-color .25s, color .25s; &:focus-visible { outline-offset: 4px; } }
    &__showcase { color: color(primary); background: color(secondary); &:hover { background: color(shadow); } }
    &__symbol { width: 48px; height: 48px; display: grid; place-items: center; flex-shrink: 0; border: 1px solid currentColor; border-radius: 50%; svg { width: 28px; stroke: currentColor; stroke-width: 1.5; } }
    &__copy { display: grid; gap: .35rem; flex: 1; min-width: 0; strong { font: 400 clamp(1.3rem, 2.2vw, 1.8rem) / 1.15 font-family(editorial); } }
    &__eyebrow { font: 400 10px / 1.5 font-family(fraktion); text-transform: uppercase; letter-spacing: .04em; }
    &__arrow { font: 400 1.8rem / 1 font-family(editorial); transition: transform .3s cubic-bezier(.22, 1, .36, 1); }
    a:hover &__arrow { transform: translate(3px, -3px); }
    &__sources { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: .75rem; }
    &__source { color: color(secondary); background: color(surface); &:hover { background: color(secondary); color: color(primary); } }
    &__github { width: 23px; height: 23px; flex-shrink: 0; }
    @media (max-width: 767px) { a { padding: 1rem; min-height: 80px; } &__sources { grid-template-columns: 1fr; } &__copy strong { font-size: 1.5rem; } &__symbol { width: 40px; height: 40px; } }
    @media (prefers-reduced-motion: reduce) { a, &__arrow { transition: none; } a:hover &__arrow { transform: none; } }
  }
</style>
