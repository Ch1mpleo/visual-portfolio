---
import { storyStepVisuals } from '../../data/storyStepVisuals'
interface Props { id: string }
const { id } = Astro.props
---
<svg class="story-step-icon" width="24" height="24" viewBox="-16 -16 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={storyStepVisuals[id].symbol} />
</svg>
<style lang="scss">
  .story-step-icon { display: block; flex: 0 0 auto; color: color(accent); }
</style>
