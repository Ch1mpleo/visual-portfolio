---
import { graphStages } from '../../data/projectInteriors'
import GraphConceptArtwork from './GraphConceptArtwork.astro'
import StoryStepIcon from './StoryStepIcon.astro'
---
<div class="project-content project-content--story">
  <section class="scroll-story" data-scroll-story aria-labelledby="graph-pipeline-title">
    <header class="story-heading">
      <p class="project-content__label">The pipeline / {String(graphStages.length).padStart(2, '0')} stages</p>
      <h3 id="graph-pipeline-title">From paper to graph.</h3>
      <p>How a research paper could become a map of connected ideas, and what exists today.</p>
    </header>
    <div class="scroll-story__body">
      <div class="scroll-story__stage" data-story-stage data-view="art" style={`--focus: 0; --objects: ${graphStages.length}; --zoom: 2.4`}>
        <div class="scroll-story__art" data-story-layer="art" role="region" aria-label="Research pipeline illustration. Select a stage to read its part of the story.">
          <GraphConceptArtwork />
        </div>
      </div>
      <ol class="scroll-story__beats">
        {graphStages.map((stage, index) => <li id={`graph-stage-${stage.id}`} class:list={['story-beat', { 'is-selected': index === 0 }]} data-story-beat={stage.id}>
          <p class="project-content__label story-beat__label"><StoryStepIcon id={stage.id} /><span>0{index + 1} / {stage.label}</span></p>
          <h4>{stage.title}</h4>
          <p>{stage.description}</p>
          <p class="story-beat__status">{stage.detail}</p>
        </li>)}
      </ol>
    </div>
  </section>
</div>
