---
import type { WorkflowId, WorkflowNodeId } from '../../data/oboxWorkflows'
interface Props { workflowId: WorkflowId }
const { workflowId } = Astro.props
type Node = { id: WorkflowNodeId; title: string; sub: string; x: number; y: number; w: number }
type Edge = { id: string; d: string }
const configurations: Record<WorkflowId, { nodes: Node[]; edges: Edge[]; description: string }> = {
  join: {
    nodes: [
      { id: 'web', title: 'Web', sub: 'Class selection', x: 4, y: 5, w: 39 },
      { id: 'mobile', title: 'Mobile', sub: 'Enrollment / schedule', x: 57, y: 5, w: 39 },
      { id: 'api', title: 'Shared API', sub: 'Validate / confirm', x: 30, y: 34, w: 40 },
      { id: 'stripe', title: 'Stripe', sub: 'Checkout / webhook', x: 4, y: 63, w: 39 },
      { id: 'records', title: 'Records', sub: 'Hold / enrollment', x: 57, y: 63, w: 39 },
      { id: 'notifications', title: 'Notifications', sub: 'Relevant users', x: 20, y: 87, w: 60 },
    ],
    edges: [{ id: 'web-api', d: 'M141 83 V121 H300 V156' }, { id: 'mobile-api', d: 'M459 83 V121 H300 V156' }, { id: 'api-stripe', d: 'M300 217 V251 H141 V290' }, { id: 'api-records', d: 'M300 217 V251 H459 V290' }, { id: 'api-notifications', d: 'M300 217 V400' }],
    description: 'Web selects a class and opens Stripe checkout through the API. Stripe reports payment to the API, which saves enrollment, serves both clients, and publishes notifications.',
  },
  'check-in': {
    nodes: [
      { id: 'mentor', title: 'Mentor', sub: 'Session tools', x: 4, y: 5, w: 39 },
      { id: 'mobile', title: 'Mobile', sub: 'Student / parent', x: 57, y: 5, w: 39 },
      { id: 'api', title: 'Shared API', sub: 'Validate / record', x: 30, y: 34, w: 40 },
      { id: 'credential', title: 'Session QR', sub: 'Short-lived code', x: 4, y: 63, w: 39 },
      { id: 'records', title: 'Records', sub: 'Enrollment / attendance', x: 57, y: 63, w: 39 },
      { id: 'notifications', title: 'Notifications', sub: 'Configured recipients', x: 20, y: 87, w: 60 },
    ],
    edges: [{ id: 'mentor-api', d: 'M141 83 V121 H300 V156' }, { id: 'mobile-api', d: 'M459 83 V121 H300 V156' }, { id: 'api-credential', d: 'M300 217 V251 H141 V290' }, { id: 'api-records', d: 'M300 217 V251 H459 V290' }, { id: 'api-notifications', d: 'M300 217 V400' }, { id: 'credential-mobile', d: 'M24 320 H12 V12 H582 V52 H576' }],
    description: 'The mentor requests a session credential through the API. A student scans it on mobile; the API validates enrollment, saves attendance, then publishes a notification on the first successful check-in.',
  },
  capture: {
    nodes: [
      { id: 'mobile', title: 'Mobile', sub: 'Mentor capture', x: 4, y: 3, w: 39 },
      { id: 'api', title: 'Shared API', sub: 'Records / callbacks', x: 57, y: 3, w: 39 },
      { id: 'storage', title: 'Storage', sub: 'S3 / product records', x: 4, y: 31, w: 39 },
      { id: 'processing', title: 'Processing', sub: 'MediaConvert / faces', x: 57, y: 31, w: 39 },
      { id: 'highlights', title: 'Highlights', sub: 'Completed reel', x: 4, y: 59, w: 39 },
      { id: 'portfolio', title: 'Web portfolio', sub: 'Import / edit draft', x: 57, y: 59, w: 39 },
      { id: 'public', title: 'Public snapshot', sub: 'Separate publication', x: 57, y: 87, w: 39 },
    ],
    edges: [{ id: 'mobile-api', d: 'M258 44 H342' }, { id: 'api-storage', d: 'M459 73 V113 H141 V143' }, { id: 'api-processing', d: 'M459 73 V143' }, { id: 'storage-processing', d: 'M258 173 H342' }, { id: 'api-highlights', d: 'M342 44 H300 V245 H141 V271' }, { id: 'storage-highlights', d: 'M141 203 V271' }, { id: 'api-portfolio', d: 'M576 44 H588 V301 H576' }, { id: 'highlights-portfolio', d: 'M258 301 H342' }, { id: 'portfolio-public', d: 'M459 331 V400' }],
    description: 'Mentor capture on mobile reaches the API and storage. Video processing and conditional face matching precede a completed highlight. The web imports the highlight into a portfolio draft; a separate action publishes a public snapshot.',
  },
}
const map = configurations[workflowId]
const initialNodes = workflowId === 'join' ? ['web'] : workflowId === 'check-in' ? ['mentor', 'api'] : ['mobile']
---
<figure class="workflow-map">
  <div class="workflow-map__drawing" role="img" aria-label={map.description}>
    <svg viewBox="0 0 600 460" preserveAspectRatio="none" fill="none" aria-hidden="true">{map.edges.map((edge) => <path d={edge.d} data-flow-edge={edge.id} class:list={['workflow-map__edge', { 'is-active': workflowId === 'check-in' && edge.id === 'mentor-api' }]} />)}</svg>
    {map.nodes.map((node) => <div aria-hidden="true" data-flow-node={node.id} class:list={['workflow-map__node', { 'is-active': initialNodes.includes(node.id) }]} style={`--x:${node.x}%;--y:${node.y}%;--w:${node.w}%`}><strong>{node.title}</strong><span>{node.sub}</span>{node.id === 'credential' && <svg class="workflow-map__qr" viewBox="0 0 20 20" aria-hidden="true"><path d="M1 1h6v6H1zM13 1h6v6h-6zM1 13h6v6H1zM11 11h3v3h-3zM16 16h3v3h-3z" fill="currentColor" /></svg>}</div>)}
  </div>
  <figcaption><span aria-hidden="true">●</span> Highlighted parts and routes belong to the selected step.</figcaption>
</figure>
<style lang="scss">
  .workflow-map { margin: 0; padding: clamp(0.75rem, 2vw, 1.5rem); border: 1px solid color(line); background: color(surface);
    &__drawing { position: relative; aspect-ratio: 600 / 320; }
    svg:not(.workflow-map__qr) { display: block; width: 100%; height: 100%; }
    &__edge { stroke: color(line); stroke-width: 1.5; opacity: 0.22; vector-effect: non-scaling-stroke; &.is-active { stroke: color(secondary); stroke-width: 2; opacity: 1; } }
    &__node { position: absolute; left: var(--x); top: var(--y); width: var(--w); min-height: 13%; display: flex; justify-content: center; flex-direction: column; padding: 0.6rem 0.7rem; border: 1px solid color(line); background: color(primary); color: color(muted); strong { font: 400 clamp(11px, 1.3vw, 15px) / 1.3 font-family(fraktion); } span { margin-top: 0.35rem; font: 400 clamp(9px, 0.95vw, 11px) / 1.3 font-family(fraktion); } &.is-active { background: color(secondary); color: color(primary); border-color: color(secondary); } }
    &__qr { position: absolute; right: 8px; top: 8px; width: 20px; height: 20px; opacity: 0.35; }
    figcaption { margin-top: 1.5rem; color: color(muted); font: 400 11px / 1.5 font-family(fraktion); span { color: color(secondary); } }
    @media (max-width: 767px) { &__drawing { aspect-ratio: 600 / 540; } &__node { padding: 0.4rem; strong { font-size: 11px; } span { font-size: 9px; margin-top: 0.2rem; } } &__qr { width: 12px; height: 12px; right: 5px; top: 5px; } }
  }
</style>
