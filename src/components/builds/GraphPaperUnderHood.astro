---
import { graphStages } from '../../data/projectInteriors'
import GraphConceptArtwork from './GraphConceptArtwork.astro'
---
<div class="project-content graph-explorer">
  <header class="graph-explorer__masthead"><p class="project-content__label">Document → Passages → Connections → Exploration</p><p id="graph-explore-hint">Illustrated concept / Inspect a stage</p></header>
  <div class="graph-explorer__stage" data-graph-scene role="region" aria-label="Interactive research pipeline" aria-describedby="graph-explore-hint" tabindex="0"><GraphConceptArtwork /></div>
  <div class="graph-explorer__caption">
    {graphStages.map((stage, index) => <section id={`graph-stage-${stage.id}`} data-graph-stage-panel={stage.id}>
      <span class="graph-explorer__number" aria-hidden="true">0{index + 1}</span><div><h4>{stage.title}</h4><p>{stage.description}</p><details class="project-disclosure"><summary>Technical detail <span aria-hidden="true">+</span></summary><p>{stage.detail}</p></details></div>
    </section>)}
  </div>
  <aside class="graph-explorer__scope" aria-label="Project scope"><span>Experiment in progress</span><p>Upload and graph interfaces, data models, and an embedding service are in place. Complete extraction, graph construction, and grounded answers remain the intended direction.</p></aside>
</div>
