---
import { projects } from '../data/projects'
import BuildSpecimen from './builds/BuildSpecimen.astro'
---

<section id="builds" class="s-builds" aria-labelledby="builds-title">
  <div class="s-builds__intro">
    <div class="s-builds__heading">
      <h2 id="builds-title">Things I've built<span class="s-builds__period">.</span></h2>
      <p class="s-builds__description">Products, experiments, and places to explore.</p>
    </div>
  </div>
  <div class="s-builds__gallery">
    {projects.map((project) => <BuildSpecimen project={project} />)}
  </div>
  <p class="s-builds__ending">and so much more..</p>
</section>

<script>
  import { revealBuilds } from './builds/GalleryMotion'
  const gallery = document.querySelector<HTMLElement>('.s-builds__gallery')
  if (gallery) revealBuilds(gallery)
</script>

<style lang="scss">
  .s-builds {
    position: relative;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1rem, 3.5vw, 4rem);
    color: color(secondary);
    background: color(primary);
    scroll-margin-top: 1.5rem;

    &__intro, &__gallery, &__ending { width: 100%; max-width: 1560px; margin-inline: auto; }
    &__ending { flex-shrink: 0; margin: 1rem auto 0; text-align: right; color: color(secondary); font: italic 400 clamp(1.25rem, 2vw, 1.75rem) / 1.1 font-family(editorial); }
    &__heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; margin-bottom: 1.5rem; }
    h2 { margin: 0; font: 700 clamp(3.5rem, 6vw, 6rem) / 0.88 font-family(bigger); text-transform: uppercase; letter-spacing: -0.01em; }
    &__period { color: color(accent); }
    &__description { margin: 0 0 0.3rem; max-width: 27ch; font: 400 clamp(1.25rem, 1.7vw, 1.6rem) / 1.4 font-family(editorial); }
    &__gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(210px, 1fr)); gap: 16px; min-height: 440px; }

    @media (min-width: 768px) and (max-width: 987px) {
      &__gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: auto; gap: 20px; }
    }
    @media (max-width: 767px) {
      padding: 3.5rem 1rem;
      &__heading { display: block; margin-bottom: 2rem; }
      h2 { font-size: clamp(3.5rem, 14vw, 6.5rem); }
      &__description { margin-top: 1.5rem; max-width: 30ch; font-size: 1.25rem; }
      &__gallery { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; gap: 16px; }
    }
  }
  @media (min-width: 1200px) {
    .s-builds {
      display: flex;
      flex-direction: column;
      height: calc(100svh - 48px);
      min-height: 700px;
      padding-block: 28px;
      &__heading { align-items: center; margin-bottom: 20px; }
      h2 { white-space: nowrap; font-size: clamp(3rem, 5vw, 4.5rem); }
      &__description { max-width: 34ch; font-size: 20px; }
      &__gallery { flex: 1; min-height: 0; grid-template-rows: repeat(2, minmax(0, 1fr)); }
    }
  }
</style>
