---
import type { ProjectLink } from '../../data/projects'
interface Props { links: readonly ProjectLink[] }
const { links } = Astro.props
const showcases = links.filter((link) => new URL(link.href).hostname !== 'github.com')
const sources = links.filter((link) => new URL(link.href).hostname === 'github.com')
---
<nav class:list={['project-actions', { 'project-actions--source-only': showcases.length === 0 }]} aria-label="Project destinations">
  {showcases.map((link) => <a class="project-actions__showcase" href={link.href} target="_blank" rel="noopener noreferrer"><span>{link.label === 'Website' ? 'Visit website' : link.label}</span><span class="project-actions__arrow" aria-hidden="true">↗</span><span class="u-sr-only"> (opens in a new tab)</span></a>)}
  {sources.length > 0 && <div class="project-actions__sources"><span class="project-actions__source-label">Code</span>{sources.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true"> ↗</span><span class="u-sr-only"> (opens in a new tab)</span></a>)}</div>}
</nav>
<style lang="scss">
  .project-actions { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 1.5rem; padding-block: 1rem; border-top: 1px solid color(line);
    a { display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; color: color(secondary); text-decoration: none; &:hover { text-decoration: underline; text-underline-offset: 5px; } &:focus-visible { outline-offset: 4px; } }
    &__showcase { gap: 1.5rem !important; font: 400 1.6rem / 1.2 font-family(editorial); }
    &__arrow { font-size: 1.8rem; transition: translate .3s cubic-bezier(.22, 1, .36, 1); }
    &__showcase:hover &__arrow { translate: 3px -3px; }
    &__sources { display: flex; align-items: center; flex-wrap: wrap; gap: .35rem 1.5rem; font: 400 11px / 1.5 font-family(fraktion); }
    &__source-label { color: color(muted); font-size: 10px; text-transform: uppercase; margin-right: .5rem; }
    &--source-only { justify-content: flex-end; }
    @media (max-width: 767px) { gap: .5rem; flex-direction: column; align-items: flex-start; &__sources { gap: .5rem 1.25rem; } &__showcase { font-size: 1.5rem; } }
    @media (prefers-reduced-motion: reduce) { &__arrow { transition: none; } }
  }
</style>
