---
import { graphStages } from '../../data/projectInteriors'
import StoryAnnotation from './StoryAnnotation.astro'
import StoryConnection from './StoryConnection.astro'
---
<svg class="graph-concept" viewBox="0 0 1200 560" role="group" aria-label="Illustrated research pipeline: document, passages and embeddings, entity connections, and graph exploration.">
  <path class="graph-grid" d="M0 94H1200M0 188H1200M0 282H1200M0 376H1200M100 0V470M200 0V470M300 0V470M400 0V470M500 0V470M600 0V470M700 0V470M800 0V470M900 0V470M1000 0V470M1100 0V470" />
  <StoryConnection path="M238 112C271 112 261 46 296 46S320 76 343 87" />
  <StoryConnection path="M538 330C567 330 559 383 595 383S622 332 649 324" delay={-1.3} />
  <StoryConnection path="M839 131C875 131 862 47 902 47S923 85 949 100" delay={-2.6} />
  {graphStages.map((stage, index) => <g class:list={['graph-concept__layer', { 'is-selected': index === 0 }]} data-story-object={stage.id} role="button" tabindex="0" aria-label={`Inspect ${stage.label.toLowerCase()}`} aria-pressed={index === 0} aria-controls={`graph-stage-${stage.id}`}>
    <rect class="graph-hit" x={index * 300 + 8} y="12" width="284" height="536" />
    <g class="graph-drawing">
      {stage.id === 'document' && <g transform="translate(53 70) rotate(-6 99 142)">
        <rect class="graph-back" x="11" y="13" width="201" height="291" /><path class="graph-paper" d="M0 0H167L201 34V291H0Z" /><path class="graph-rule" d="M167 0V34H201" />
        <text class="graph-kicker" x="19" y="38">RESEARCH / 001</text><text class="graph-editorial" x="19" y="82">A starting</text><text class="graph-editorial" x="19" y="113">point.</text>
        <path class="graph-rule" d="M19 137H180M19 161H156M19 180H176M19 199H145M19 235H179M19 254H157" /><rect class="graph-ink" x="19" y="210" width="119" height="7" />
      </g>}
      {stage.id === 'chunks' && <g transform="translate(333 82)">
        {[0,1,2].map((i) => <g transform={`translate(${i % 2 === 0 ? 0 : -8} ${i * 93}) rotate(${i % 2 === 0 ? 3 : -3} 107 36)`}><rect class="graph-back" x="7" y="7" width="220" height="77" /><rect class="graph-paper" width="220" height="77" /><text class="graph-kicker" x="14" y="23">PASSAGE / 0{i + 1}</text><path class="graph-rule" d="M14 41H140M14 57H116" /><path class="graph-vector" d="M156 26V61M166 39V61M176 20V61M186 34V61M196 14V61M206 45V61" /></g>)}
      </g>}
      {stage.id === 'entities' && <g transform="translate(618 82)">
        <path class="graph-rule" d="M47 97L190 50L177 221L47 97M47 97L56 251M190 50L243 128M177 221L243 128" />
        <circle class="graph-node" cx="47" cy="97" r="25" /><circle class="graph-node" cx="190" cy="50" r="17" /><circle class="graph-node" cx="177" cy="221" r="20" /><circle class="graph-node" cx="56" cy="251" r="10" /><circle class="graph-node" cx="243" cy="128" r="10" />
        <text class="graph-editorial graph-node-label" x="0" y="56">Concept</text><text class="graph-editorial graph-node-label" x="123" y="18">Method</text><text class="graph-editorial graph-node-label" x="131" y="274">Finding</text>
      </g>}
      {stage.id === 'graph' && <g transform="translate(938 72)">
        <path class="graph-paper" d="M0 0H221V299H0Z" /><path class="graph-rule" d="M0 33H221" /><circle class="graph-ink" cx="14" cy="17" r="3" /><circle class="graph-node" cx="26" cy="17" r="3" /><text class="graph-kicker" x="43" y="22">EXPLORE / GRAPH</text>
        <path class="graph-rule" d="M39 157L102 95L184 142L152 229L39 157M102 95L152 229M39 157L51 248M184 142L188 74" />
        <circle class="graph-ink" cx="39" cy="157" r="12" /><circle class="graph-node" cx="102" cy="95" r="9" /><circle class="graph-node" cx="184" cy="142" r="9" /><circle class="graph-node" cx="152" cy="229" r="9" /><circle class="graph-ink" cx="51" cy="248" r="4" /><circle class="graph-ink" cx="188" cy="74" r="4" />
        <circle class="graph-orbit" cx="39" cy="157" r="23" /><text class="graph-small" x="12" y="283">AN IDEA, IN CONTEXT</text>
      </g>}
    </g>
    <StoryAnnotation id={stage.id} index={index} label={stage.label} x={index * 300 + 20} y={430} width={260} />
  </g>)}
</svg>
<style lang="scss">
  .graph-concept { display: block; width: 100%; height: auto; color: color(secondary);
    .graph-grid { fill: none; stroke: color(line); opacity: .18; stroke-width: .7; }
    .graph-paper { fill: color(primary); stroke: currentColor; stroke-width: 1.5; }
    .graph-back { fill: color(surface-raised); stroke: color(line); }
    .graph-rule { fill: none; stroke: currentColor; stroke-width: 1.5; }
    .graph-vector { fill: none; stroke: color(accent); stroke-width: 2; }
    .graph-ink { fill: color(secondary); }
    .graph-node { fill: color(primary); stroke: color(secondary); stroke-width: 1.5; }
    .graph-orbit { fill: none; stroke: color(accent); stroke-dasharray: 3 4; }
    text { fill: currentColor; font-family: font-family(fraktion); }
    .graph-kicker { font-size: 11px; }
    .graph-small { font-size: 10px; }
    .graph-editorial { font: 400 32px font-family(editorial); }
    .graph-node-label { font-size: 24px; }
    &__layer { cursor: pointer; outline: none; }
  }
</style>
