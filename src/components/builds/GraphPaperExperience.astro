---
import type { Project } from '../../data/projects'
interface Props { project: Project }
const { project } = Astro.props
---
<div class="project-content project-hero project-hero--text">
  <div class="project-hero__copy">
    <p class="project-content__label">GraphRAG / Experiment in progress</p>
    <h3>Paper to possibility.</h3>
    <p>An experiment in turning research papers into connected ideas, with an interface and backend foundations to explore the direction.</p>
    <p class="project-content__label project-hero__role">{project.contribution}</p>
  </div>
</div>
