---
import localTrackUrl from '../assets/music/no-church-in-the-wild.mp3?url'
import albumArtUrl from '../assets/music/watch-the-throne.jpg?url'
import { vaMarkPaths } from '../utils/brand-marks'

const armFacetLight = [88, 63, 38, 20, 13, 30, 53, 78]
const fullTrackUrl = import.meta.env.PUBLIC_MUSIC_TRACK_URL?.trim()
const publicBase = import.meta.env.BASE_URL.replace(/\/$/, '')
const audioUrl = fullTrackUrl
  ? /^https?:\/\//.test(fullTrackUrl)
    ? fullTrackUrl
    : `${publicBase}/${fullTrackUrl.replace(/^\/+/, '')}`
  : localTrackUrl
---

<aside class="music-player" data-music-player aria-label="Music player">
  <!-- Borderless spinning vinyl disc trigger -->
  <button
    class="music-player__toggle"
    type="button"
    data-music-toggle
    aria-label="Play No Church In The Wild"
    aria-pressed="false"
    aria-expanded="false"
    aria-controls="music-player-panel"
  >
    <span class="music-player__medallion" aria-hidden="true">
      <span class="music-player__medallion-label">
        <img src={albumArtUrl} alt="" width="30" height="30" loading="lazy" draggable="false" />
      </span>
      <span class="music-player__medallion-spindle"></span>
    </span>
    <span class="music-player__toggle-glyph" aria-hidden="true">
      <svg class="music-player__sound" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M11 5 6 9H3v6h3l5 4V5Z" />
        <g class="music-player__waves"><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" /></g>
        <g class="music-player__mute"><path d="m16 9 6 6m0-6-6 6" /></g>
      </svg>
    </span>
  </button>

  <div class="music-player__panel" id="music-player-panel" inert>
    <div class="music-player__stage" data-music-stage>
      <div class="music-player__shadow" aria-hidden="true"></div>

      <div class="music-player__gimbal">
        <div class="music-player__plinth" data-music-plinth>
          <!-- Hinged 3D translucent acrylic dust cover -->
          <div class="dust-hinges" aria-hidden="true">
            <span class="dust-hinge dust-hinge--left"></span>
            <span class="dust-hinge dust-hinge--right"></span>
          </div>
          <div class="dust-cover" aria-hidden="true">
            <div class="dust-cover__top">
              <span class="dust-cover__bumper"></span>
            </div>
            <div class="dust-cover__front"></div>
            <div class="dust-cover__left"></div>
            <div class="dust-cover__right"></div>
          </div>

          <!-- Top deck surface -->
          <div class="plinth-face plinth-face--top">
            <span class="deck-screw deck-screw--tl" aria-hidden="true"></span>
            <span class="deck-screw deck-screw--tr" aria-hidden="true"></span>
            <span class="deck-screw deck-screw--bl" aria-hidden="true"></span>
            <span class="deck-screw deck-screw--br" aria-hidden="true"></span>

            <!-- Recessed brushed aluminum right-hand control bay -->
            <div class="control-bay" aria-hidden="true">
              <span class="control-bay__screw control-bay__screw--1"></span>
              <span class="control-bay__screw control-bay__screw--2"></span>
            </div>

            <!-- Deep platter well + stacked machined aluminum platter + 1:1 scratchable vinyl -->
            <div class="deck-well" aria-hidden="true"></div>
            <div class="platter-stack">
              <span class="platter-rim platter-rim--1" aria-hidden="true"></span>
              <span class="platter-rim platter-rim--2" aria-hidden="true"></span>
              <span class="platter-rim platter-rim--3" aria-hidden="true"></span>
              <div
                class="music-player__platter"
                data-music-platter
                role="slider"
                tabindex="-1"
                aria-disabled="true"
                aria-label="Record position"
                aria-valuemin="0"
                aria-valuemax="0"
                aria-valuenow="0"
                aria-valuetext="Audio not loaded"
              >
                <div class="music-player__cue" data-music-cue aria-hidden="true">
                  <div class="music-player__disc">
                    <img src={albumArtUrl} alt="" width="88" height="88" loading="lazy" draggable="false" />
                    <span class="music-player__record-mark"></span>
                  </div>
                </div>
                <span class="music-player__spindle" aria-hidden="true"></span>
              </div>
            </div>

            <!-- Classic front-left playful 3D Start / Stop button -->
            <button
              class="deck-play"
              type="button"
              data-music-deck-play
              aria-label="Start turntable"
              aria-pressed="false"
            >
              <span class="deck-play__base" aria-hidden="true"></span>
              <span class="deck-play__cap" aria-hidden="true">
                <span class="deck-play__led"></span>
                <svg class="deck-play__icon deck-play__icon--play" viewBox="0 0 12 12" fill="currentColor">
                  <path d="M3 2.2 10 6 3 9.8V2.2Z" />
                </svg>
                <svg class="deck-play__icon deck-play__icon--stop" viewBox="0 0 12 12" fill="currentColor">
                  <rect x="2.5" y="2.5" width="7" height="7" rx="0.8" />
                </svg>
              </span>
            </button>

            <!-- Sculpted multi-face 3D Tonearm Assembly -->
            <div class="tonearm-assembly">
              <!-- Stepped 3D gimbal turret + bearing yoke + anti-skate dial -->
              <div class="tonearm-base" data-music-tonearm-pivot aria-hidden="true">
                <span class="tonearm-base__ring tonearm-base__ring--1"></span>
                <span class="tonearm-base__ring tonearm-base__ring--2"></span>
                <span class="tonearm-base__ring tonearm-base__ring--3"></span>
                <span class="tonearm-base__yoke tonearm-base__yoke--left"></span>
                <span class="tonearm-base__yoke tonearm-base__yoke--right"></span>
                <span class="tonearm-base__cap"></span>
                <span class="tonearm-antiskate"></span>
              </div>

              <!-- 3D U-shaped tonearm cradle rest -->
              <div class="tonearm-rest" aria-hidden="true">
                <span class="tonearm-rest__post"></span>
                <span class="tonearm-rest__cradle"></span>
              </div>

              <!-- Dynamic projected shadow on the plinth/vinyl -->
              <div class="music-player__tonearm-shadow" aria-hidden="true"></div>

              <div class="music-player__tonearm">
                <div class="tonearm__weight" aria-hidden="true">
                  {armFacetLight.map((light, index) => (
                    <span class="tonearm__facet" style={`--facet-angle: ${index * 45}deg; --facet-light: ${light}%`}></span>
                  ))}
                  <span class="tonearm__weight-cap tonearm__weight-cap--rear"></span>
                  <span class="tonearm__weight-cap tonearm__weight-cap--front"></span>
                </div>

                <!-- Gimbal collar -->
                <span class="tonearm__collar" aria-hidden="true"></span>

                <!-- 3D Tubular chrome arm rod (orthogonal top + vertical depth wall) -->
                <div class="tonearm__rod" aria-hidden="true">
                  {armFacetLight.map((light, index) => (
                    <span class="tonearm__facet" style={`--facet-angle: ${index * 45}deg; --facet-light: ${light}%`}></span>
                  ))}
                </div>

                <!-- Sculpted 3D extruded headshell + finger lift + recessed cartridge + gold stylus needle -->
                <div class="tonearm__headshell" aria-hidden="true">
                  <span class="tonearm__hs-top">
                    <span class="tonearm__hs-slot tonearm__hs-slot--1"></span>
                    <span class="tonearm__hs-slot tonearm__hs-slot--2"></span>
                  </span>
                  <span class="tonearm__hs-front"></span>
                  <span class="tonearm__hs-left"></span>
                  <span class="tonearm__hs-right"></span>
                  <span class="tonearm__fingerlift"></span>
                  <span class="tonearm__cartridge">
                    <span class="tonearm__stylus"></span>
                  </span>
                </div>

                <button
                  class="tonearm__handle"
                  type="button"
                  tabindex="-1"
                  data-music-tonearm-handle
                  aria-label="Drag tonearm across record or tap to play"
                ></button>
              </div>
            </div>

            <!-- Interactive Vertical 3D Volume Fader Slider (SL-1200 style) -->
            <div class="fader-assembly">
              <span class="fader-header" aria-hidden="true">
                <span class="fader-header__rpm">33⅓</span>
                <span class="fader-header__strobe"></span>
              </span>
              <div
                class="music-player__fader"
                data-music-fader
                role="slider"
                tabindex="0"
                aria-orientation="vertical"
                aria-label="Music volume"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="65"
                aria-valuetext="65 percent"
              >
                <span class="fader__stop fader__stop--top" data-music-fader-stop aria-hidden="true"></span>
                <span class="fader__stop fader__stop--bottom" data-music-fader-stop aria-hidden="true"></span>
                <span class="fader__ticks fader__ticks--left" aria-hidden="true"></span>
                <span class="fader__ticks fader__ticks--right" aria-hidden="true"></span>
                <span class="fader__slot" aria-hidden="true">
                  <span class="fader__fill"></span>
                </span>
                <!-- Sculpted 3D metallic fader thumb block -->
                <div class="fader__thumb" aria-hidden="true">
                  <span class="fader__thumb-top" data-music-fader-grip>
                    <span class="fader__thumb-groove"></span>
                  </span>
                  <span class="fader__thumb-stem"></span>
                  <span class="fader__thumb-front"></span>
                  <span class="fader__thumb-back"></span>
                  <span class="fader__thumb-left"></span>
                  <span class="fader__thumb-right"></span>
                </div>
              </div>
              <span class="fader-label" aria-hidden="true">VOL</span>
            </div>
          </div>

          <!-- Brushed aluminum front faceplate -->
          <div class="plinth-face plinth-face--front" aria-hidden="true">
            <span class="front-brand">CH1·MK1</span>
            <span class="front-groove"></span>
            <span class="front-power-ring">
              <span class="front-power-dot"></span>
            </span>
          </div>

          <!-- Rear panel with RCA phono jacks + DC 12V -->
          <div class="plinth-face plinth-face--back" aria-hidden="true">
            <span class="back-label">PHONO OUT</span>
            <span class="back-jacks">
              <span class="back-jack back-jack--left"></span>
              <span class="back-jack back-jack--right"></span>
              <span class="back-gnd"></span>
            </span>
            <span class="back-power">DC 12V</span>
          </div>

          <!-- Wood/slate side cheeks -->
          <div class="plinth-face plinth-face--left" aria-hidden="true"></div>
          <div class="plinth-face plinth-face--right" aria-hidden="true"></div>

          <!-- Underside baseplate with isolation feet and the VA mark -->
          <div class="plinth-face plinth-face--bottom" aria-hidden="true">
            <span class="base-foot base-foot--tl"></span>
            <span class="base-foot base-foot--tr"></span>
            <span class="base-foot base-foot--bl"></span>
            <span class="base-foot base-foot--br"></span>
            <svg class="base-mark" viewBox="0 0 280 280" fill="currentColor">
              {vaMarkPaths.map((path) => <path d={path} />)}
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Pure floating text caption only (no background) -->
    <div class="music-player__caption">
      <p class="music-player__title">No Church In The Wild</p>
      <p class="music-player__feat">JAŸ-Z &amp; Kanye West · feat. Frank Ocean &amp; The-Dream</p>
      <span class="music-player__status-live" data-music-status role="status">Sound off</span>
    </div>
  </div>

  <audio data-music-audio data-audio-url={audioUrl} preload="none" crossorigin="anonymous"></audio>
</aside>

<script>
  import { createTurntablePhysics } from '../utils/music-physics'
  import { createTurntable } from '../utils/music-turntable'

  const player = document.querySelector<HTMLElement>('[data-music-player]')!
  const toggle = player.querySelector<HTMLButtonElement>('[data-music-toggle]')!
  const deckPlay = player.querySelector<HTMLButtonElement>('[data-music-deck-play]')!
  const panel = player.querySelector<HTMLElement>('#music-player-panel')!
  const stage = player.querySelector<HTMLElement>('[data-music-stage]')!
  const status = player.querySelector<HTMLElement>('[data-music-status]')!
  const audio = player.querySelector<HTMLAudioElement>('[data-music-audio]')!

  let audioContext: AudioContext | undefined
  let gain: GainNode | undefined
  let wantsPlayback = false
  let playing = false
  let resumeAfterScratch = false
  let playbackRequest = 0
  let startupTimer: ReturnType<typeof setTimeout>
  let closeTimer: ReturnType<typeof setTimeout>

  let savedVolume = 65
  try {
    const raw = localStorage.getItem('portfolio-music-volume')
    if (raw !== null && Number.isFinite(Number(raw))) {
      savedVolume = Math.max(0, Math.min(100, Math.round(Number(raw))))
    }
  } catch {}

  let currentVolume = savedVolume
  const physics = createTurntablePhysics(player, stage, () => currentVolume / 100)

  function applyVolume(percent: number) {
    currentVolume = Math.max(0, Math.min(100, Math.round(percent)))
    const level = currentVolume / 100
    // Gain works on mobile too, where media-element volume may be system-controlled.
    if (gain && audioContext) {
      gain.gain.setTargetAtTime(level ** 2, audioContext.currentTime, 0.025)
    } else {
      audio.volume = level
    }
    player.classList.toggle('is-muted', level === 0)
    try {
      localStorage.setItem('portfolio-music-volume', String(currentVolume))
    } catch {}
    physics.refresh()
  }

  function togglePlayback() {
    expand(true)
    if (playing || wantsPlayback) stopPlayback()
    else void requestPlayback()
  }

  const turntable = createTurntable(player, savedVolume, {
    onSeek(seconds) {
      audio.currentTime = seconds
    },
    onScratchStart() {
      // Temporarily hold audio while hand is on the vinyl so scratching is instant and stutter-free.
      resumeAfterScratch = playing || wantsPlayback
      if (resumeAfterScratch && !audio.paused) audio.pause()
    },
    onScratchEnd(seconds) {
      audio.currentTime = seconds
      const shouldResume = resumeAfterScratch
      resumeAfterScratch = false
      if (shouldResume) {
        wantsPlayback = true
        void audio.play().catch(() => {})
      } else {
        updateTimeline()
      }
    },
    onVolume: applyVolume,
    onTogglePlay: togglePlayback,
    onInteractChange(active) {
      physics.setInteracting(active)
    },
  })

  function updateTimeline() {
    const hasDuration = Number.isFinite(audio.duration) && audio.duration > 0
    const currentTime = hasDuration ? Math.max(0, Math.min(audio.currentTime, audio.duration)) : 0
    turntable.update(currentTime, hasDuration ? audio.duration : 0)
  }

  for (const type of ['loadedmetadata', 'durationchange', 'timeupdate', 'seeking', 'seeked', 'emptied']) {
    audio.addEventListener(type, updateTimeline)
  }

  function connectAudio() {
    if (audioContext || !window.AudioContext) return
    audioContext = new AudioContext()
    const source = audioContext.createMediaElementSource(audio)
    const analyser = audioContext.createAnalyser()
    analyser.fftSize = 512
    analyser.smoothingTimeConstant = 0.78
    gain = audioContext.createGain()
    gain.gain.value = (currentVolume / 100) ** 2
    audio.volume = 1
    source.connect(analyser)
    analyser.connect(gain)
    gain.connect(audioContext.destination)
    physics.connect(analyser)
  }

  function expand(open: boolean) {
    clearTimeout(closeTimer)
    player.classList.toggle('is-expanded', open)
    toggle.setAttribute('aria-expanded', String(open))
    panel.inert = !open
    physics.setOpen(open)
  }

  function setPlayback(active: boolean, message: string) {
    playing = active
    player.classList.toggle('is-playing', active)
    toggle.setAttribute('aria-pressed', String(active))
    toggle.setAttribute('aria-label', active ? 'Pause No Church In The Wild' : 'Play No Church In The Wild')
    deckPlay.setAttribute('aria-pressed', String(active))
    deckPlay.setAttribute('aria-label', active ? 'Stop turntable' : 'Start turntable')
    status.textContent = message
    physics.setPlaying(active)
  }

  async function requestPlayback() {
    const request = ++playbackRequest
    wantsPlayback = true
    player.classList.remove('has-error')
    status.textContent = 'Starting song…'
    try {
      connectAudio()
      if (!audio.src) audio.src = audio.dataset.audioUrl!
      else if (audio.error) audio.load()
      const resumed = audioContext?.resume()
      // Call play inside the original gesture, before awaiting anything.
      const started = audio.play()
      startupTimer = setTimeout(() => {
        if (request === playbackRequest && wantsPlayback && !playing) {
          stopPlayback()
          setPlayback(false, 'Can’t load song. Tap to retry.')
          player.classList.add('has-error')
        }
      }, 15000)
      await Promise.all([resumed, started])
      if (request !== playbackRequest || !wantsPlayback) audio.pause()
    } catch (error) {
      if (request !== playbackRequest) return
      stopPlayback()
      const blocked = error instanceof DOMException && error.name === 'NotAllowedError'
      setPlayback(false, blocked ? 'Tap to try again.' : 'Can’t load song. Tap to retry.')
      player.classList.add('has-error')
    }
  }

  function stopPlayback() {
    playbackRequest++
    wantsPlayback = false
    resumeAfterScratch = false
    clearTimeout(startupTimer)
    audio.pause()
    setPlayback(false, 'Sound off')
  }

  function isDraggingAnything() {
    return (
      physics.isOrbiting() ||
      player.classList.contains('is-scrubbing') ||
      player.classList.contains('is-sliding-fader')
    )
  }

  audio.addEventListener('playing', () => {
    if (!wantsPlayback) {
      audio.pause()
      return
    }
    clearTimeout(startupTimer)
    setPlayback(true, 'Now playing')
  })
  audio.addEventListener('waiting', () => {
    if (wantsPlayback) setPlayback(false, 'Buffering…')
  })
  audio.addEventListener('pause', () => {
    if (resumeAfterScratch) return
    wantsPlayback = false
    if (!player.classList.contains('has-error')) setPlayback(false, 'Sound off')
  })
  audio.addEventListener('ended', stopPlayback)
  audio.addEventListener('error', () => {
    stopPlayback()
    setPlayback(false, 'Can’t load song. Tap to retry.')
    player.classList.add('has-error')
  })

  player.addEventListener('pointerenter', (event) => {
    if (event.pointerType === 'mouse') expand(true)
  })
  player.addEventListener('pointerleave', (event) => {
    if (event.pointerType !== 'mouse') return
    closeTimer = setTimeout(() => {
      if (
        !isDraggingAnything() &&
        !panel.contains(document.activeElement) &&
        !toggle.matches(':focus-visible')
      ) {
        expand(false)
      }
    }, 240)
  })
  player.addEventListener('focusin', (event) => {
    if (event.target !== toggle || toggle.matches(':focus-visible')) expand(true)
  })
  player.addEventListener('focusout', () => {
    closeTimer = setTimeout(() => {
      if (!isDraggingAnything() && !player.contains(document.activeElement) && !player.matches(':hover')) {
        expand(false)
      }
    }, 0)
  })

  toggle.addEventListener('click', togglePlayback)
  deckPlay.addEventListener('click', (event) => {
    event.stopPropagation()
    togglePlayback()
  })

  document.addEventListener('pointerdown', (event) => {
    if (!isDraggingAnything() && !player.contains(event.target as Node)) expand(false)
  })
  player.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      toggle.focus({ preventScroll: true })
      expand(false)
      event.stopPropagation()
    }
  })

  document.addEventListener('open-video-popup', stopPlayback)
  document.addEventListener(
    'play',
    (event) => {
      const media = event.target
      if (media instanceof HTMLMediaElement && media !== audio && !media.muted) stopPlayback()
    },
    true,
  )
  window.addEventListener('pagehide', stopPlayback)
</script>

<style lang="scss">
  .music-player {
    /* Light theme: warm satin timber/ceramic plinth + brushed silver faceplate + oxblood ink */
    --deck-wood-hi: #f5e2d5;
    --deck-wood-mid: #e6cbb9;
    --deck-wood-lo: #cfa993;
    --deck-face-hi: #fbf7f4;
    --deck-face-mid: #e7ddd6;
    --deck-face-lo: #ccc0b7;
    --deck-bay-hi: #f7f1ec;
    --deck-bay-lo: #ded3ca;
    --deck-bottom: #ccb4a4;
    --deck-border: #160000;
    --deck-border-soft: rgb(22 0 0 / 0.24);
    --deck-ink: #160000;
    --deck-muted: #4d4040;
    --deck-well: #c5aa98;
    --deck-chrome-hi: #ffffff;
    --deck-chrome-mid: #c5bdb6;
    --deck-chrome-lo: #6c635c;
    --deck-brass: #b8843f;
    --deck-led-off: rgb(22 0 0 / 0.24);
    --deck-led-on: #c97b1e;
    --deck-led-glow: rgb(201 123 30 / 0.72);
    --deck-shadow: rgb(22 0 0 / 0.3);
    --deck-brush: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px);
    --deck-edge-light: color-mix(in srgb, var(--deck-chrome-hi) 46%, transparent);
    --deck-edge-dark: color-mix(in srgb, var(--deck-ink) 24%, var(--deck-wood-lo));
    --lid-tint: rgb(255 248 244 / 0.26);
    --lid-edge: rgb(22 0 0 / 0.34);
    --lid-sheen: rgb(255 255 255 / 0.45);
    --text-halo: rgb(255 242 237 / 0.92);

    --deck-scale: 1;
    --deck-scale-anim: 0.74;
    --deck-y: 40px;
    --deck-rx: 66deg;
    --deck-ry: 0deg;
    --deck-rz: 14deg;
    --lid-angle: 0deg;
    --float-open: 0;
    --shadow-scale: 0.58;
    --shadow-opacity: 0;
    --shadow-x: 0px;
    --shadow-y: 8px;
    --music-energy: 0;
    --music-bass: 0;
    --volume-level: 65%;
    --fader-ratio: 0.65;
    --tonearm-angle: 22deg;

    position: fixed;
    right: max(28px, env(safe-area-inset-right));
    bottom: max(28px, env(safe-area-inset-bottom));
    z-index: 30;
    color: var(--deck-ink);
    font-family: font-family(fraktion);
  }

  :global(.theme-dark) .music-player {
    /* Dark theme: smoked walnut/slate plinth + brushed titanium faceplate + antique gold */
    --deck-wood-hi: #302c2a;
    --deck-wood-mid: #232120;
    --deck-wood-lo: #171616;
    --deck-face-hi: #3a3f46;
    --deck-face-mid: #282c31;
    --deck-face-lo: #1c1f23;
    --deck-bay-hi: #2f343a;
    --deck-bay-lo: #202428;
    --deck-bottom: #141618;
    --deck-border: #595e64;
    --deck-border-soft: rgb(238 233 223 / 0.2);
    --deck-ink: #eee9df;
    --deck-muted: #b7b2a9;
    --deck-well: #101214;
    --deck-chrome-hi: #f0e8d8;
    --deck-chrome-mid: #b3a488;
    --deck-chrome-lo: #50493c;
    --deck-brass: #d6c5a3;
    --deck-led-off: rgb(238 233 223 / 0.22);
    --deck-led-on: #e8c16c;
    --deck-led-glow: rgb(232 193 108 / 0.75);
    --deck-shadow: rgb(0 0 0 / 0.65);
    --lid-tint: rgb(225 230 236 / 0.1);
    --lid-edge: rgb(238 233 223 / 0.26);
    --lid-sheen: rgb(255 255 255 / 0.16);
    --text-halo: rgb(20 22 24 / 0.92);
  }

  /* Larger borderless spinning vinyl trigger */
  .music-player__toggle {
    position: relative;
    display: block;
    width: 66px;
    height: 66px;
    padding: 0;
    margin-left: auto;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--deck-ink);
    cursor: pointer;
    filter: drop-shadow(0 8px 16px var(--deck-shadow));
    transition: transform 240ms ease(out-expo), filter 240ms ease(out-expo);

    &:hover {
      transform: translateY(-4px) scale(1.07);
      filter: drop-shadow(0 12px 22px var(--deck-shadow));
    }

    &:active {
      transform: translateY(-1px) scale(0.98);
    }

    &:focus-visible {
      outline: 2px solid color(accent);
      outline-offset: 5px;
    }
  }

  .music-player__medallion {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background:
      conic-gradient(
        from 20deg,
        transparent 0deg,
        rgb(255 250 240 / 0.2) 38deg,
        transparent 80deg 185deg,
        rgb(255 250 240 / 0.14) 225deg,
        transparent 270deg
      ),
      repeating-radial-gradient(circle, #0e0e0f 0 1.1px, #2a2928 1.8px, #131314 2.8px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
    animation: record-spin 3.8s linear infinite paused;
  }

  .is-playing .music-player__medallion {
    animation-play-state: running;
  }

  .music-player__medallion-label {
    position: absolute;
    inset: 27%;
    overflow: hidden;
    border-radius: 50%;
    border: 1.5px solid var(--deck-brass);

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .music-player__medallion-spindle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--deck-chrome-hi), var(--deck-chrome-lo));
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.55);
    transform: translate(-50%, -50%);
  }

  .music-player__toggle-glyph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(16 14 14 / 0.46);
    color: #fff2ed;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .music-player__toggle:hover .music-player__toggle-glyph,
  .music-player__toggle:focus-visible .music-player__toggle-glyph,
  .is-muted .music-player__toggle-glyph {
    opacity: 1;
  }

  .music-player__waves { display: none; }
  .is-playing .music-player__waves { display: block; }
  .is-playing .music-player__mute { display: none; }
  .is-playing.is-muted .music-player__waves { display: none; }
  .is-playing.is-muted .music-player__mute { display: block; }

  /* Frameless floating 3D container */
  .music-player__panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    width: min(352px, calc(100vw - 24px));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: var(--float-open);
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 320ms;

    &::after {
      content: '';
      position: absolute;
      top: 100%;
      right: 0;
      width: 100%;
      height: 20px;
    }
  }

  .is-expanded .music-player__panel {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s linear 0s;
  }

  /* 3D Perspective stage */
  .music-player__stage {
    position: relative;
    width: 100%;
    height: calc(256px * var(--deck-scale));
    display: grid;
    place-items: center;
    padding-top: calc(28px * var(--deck-scale));
    perspective: 1020px;
    perspective-origin: 50% 48%;
    touch-action: none;
    user-select: none;
  }

  .music-player__shadow {
    position: absolute;
    bottom: calc(10px * var(--deck-scale));
    width: calc(248px * var(--deck-scale));
    height: calc(78px * var(--deck-scale));
    border-radius: 50%;
    background: radial-gradient(ellipse at center, var(--deck-shadow) 0%, transparent 72%);
    filter: blur(16px);
    opacity: var(--shadow-opacity);
    transform: translate3d(var(--shadow-x), var(--shadow-y), 0) scale(var(--shadow-scale));
    pointer-events: none;
  }

  .music-player__gimbal {
    position: relative;
    width: 274px;
    height: 214px;
    transform-style: preserve-3d;
    transform:
      translate3d(0, var(--deck-y), 0)
      scale(calc(var(--deck-scale) * var(--deck-scale-anim)))
      rotateX(var(--deck-rx))
      rotateY(var(--deck-ry))
      rotateZ(var(--deck-rz));
    will-change: transform;
  }

  .music-player__plinth {
    position: relative;
    width: 274px;
    height: 214px;
    transform-style: preserve-3d;
    cursor: grab;
  }

  .is-orbiting .music-player__plinth {
    cursor: grabbing;
  }

  /* Hinged translucent 3D acrylic dust cover */
  .dust-hinges {
    position: absolute;
    top: -2px;
    left: 0;
    right: 0;
    height: 14px;
    transform-style: preserve-3d;
    transform: translateZ(15px);
    pointer-events: none;
  }

  .dust-hinge {
    position: absolute;
    top: 0;
    width: 22px;
    height: 12px;
    background: linear-gradient(180deg, #2d2e30, #121315);
    border: 1px solid var(--deck-border);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.35);

    &--left { left: 32px; }
    &--right { right: 32px; }
  }

  .dust-cover {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform-origin: 50% 0%;
    transform: translateZ(15px) rotateX(var(--lid-angle));
    pointer-events: none;
  }

  .dust-cover__top {
    position: absolute;
    inset: 0;
    transform: translateZ(26px);
    background:
      linear-gradient(128deg, var(--lid-sheen) 0%, var(--lid-tint) 36%, transparent 62%, var(--lid-tint) 100%);
    border: 1px solid var(--lid-edge);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35);
  }

  .dust-cover__bumper {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22px;
    height: 22px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #3a3a3d, #0f1012);
    border: 1px solid rgb(255 255 255 / 0.25);
    opacity: 0.72;
  }

  .dust-cover__front {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 274px;
    height: 26px;
    transform-origin: 50% 100%;
    transform: rotateX(-90deg);
    background: linear-gradient(180deg, var(--lid-sheen), var(--lid-tint));
    border: 1px solid var(--lid-edge);
  }

  .dust-cover__left,
  .dust-cover__right {
    position: absolute;
    top: 0;
    width: 26px;
    height: 214px;
    background: linear-gradient(90deg, var(--lid-tint), var(--lid-sheen));
    border: 1px solid var(--lid-edge);
  }

  .dust-cover__left {
    left: 0;
    transform-origin: 0% 50%;
    transform: rotateY(90deg);
  }

  .dust-cover__right {
    right: 0;
    transform-origin: 100% 50%;
    transform: rotateY(-90deg);
  }

  /* Closed 6-face plinth (274 x 214 x 26px) */
  .plinth-face {
    position: absolute;
    box-sizing: border-box;
    backface-visibility: hidden;
  }

  .plinth-face--top {
    inset: 0;
    transform-style: preserve-3d;
    transform: translateZ(13px);
    background:
      var(--deck-brush),
      linear-gradient(148deg, var(--deck-wood-hi), var(--deck-wood-mid) 54%, var(--deck-wood-lo));
    border: 1px solid var(--deck-edge-dark);
    box-shadow:
      inset 1px 1px 0 var(--deck-edge-light),
      inset -1px -1px 0 var(--deck-edge-dark),
      inset 0 0 0 4px color-mix(in srgb, var(--deck-wood-lo) 15%, transparent);
  }

  .plinth-face--bottom {
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(180deg) translateZ(13px);
    background: linear-gradient(145deg, var(--deck-bottom), var(--deck-wood-lo));
    border: 1px solid var(--deck-border);
    display: grid;
    place-items: center;
  }

  .plinth-face--front {
    left: 0;
    top: 50%;
    width: 274px;
    height: 26px;
    margin-top: -13px;
    transform: rotateX(-90deg) translateZ(107px);
    background:
      var(--deck-brush),
      linear-gradient(180deg, var(--deck-face-hi), var(--deck-face-mid) 46%, var(--deck-face-lo));
    border: 1px solid var(--deck-edge-dark);
    box-shadow: inset 0 1px var(--deck-edge-light), inset 0 -2px var(--deck-edge-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    gap: 12px;
  }

  .plinth-face--back {
    left: 0;
    top: 50%;
    width: 274px;
    height: 26px;
    margin-top: -13px;
    transform: rotateZ(180deg) rotateX(-90deg) translateZ(107px);
    background: linear-gradient(180deg, var(--deck-wood-mid) 0%, var(--deck-wood-lo) 100%);
    border: 1px solid var(--deck-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    gap: 8px;
  }

  .plinth-face--left,
  .plinth-face--right {
    left: 50%;
    top: 50%;
    width: 214px;
    height: 26px;
    margin-left: -107px;
    margin-top: -13px;
    background: linear-gradient(180deg, var(--deck-wood-mid) 0%, var(--deck-wood-lo) 100%);
    border: 1px solid var(--deck-border);

    &::after {
      content: '';
      position: absolute;
      left: 10px;
      right: 10px;
      top: 50%;
      height: 1px;
      background: var(--deck-border-soft);
    }
  }

  .plinth-face--left {
    transform: rotateZ(90deg) rotateX(-90deg) translateZ(137px);
  }

  .plinth-face--right {
    transform: rotateZ(-90deg) rotateX(-90deg) translateZ(137px);
  }

  .deck-screw {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--deck-chrome-hi), var(--deck-chrome-lo));
    border: 0.5px solid var(--deck-border-soft);
    pointer-events: none;

    &--tl { top: 8px; left: 8px; }
    &--tr { top: 8px; right: 8px; }
    &--bl { bottom: 8px; left: 8px; }
    &--br { bottom: 8px; right: 8px; }
  }

  /* Recessed brushed aluminum right-hand control bay */
  .control-bay {
    position: absolute;
    top: 14px;
    right: 12px;
    bottom: 14px;
    width: 82px;
    border-radius: 3px;
    background:
      var(--deck-brush),
      linear-gradient(153deg, var(--deck-bay-hi), var(--deck-bay-lo));
    border: 1px solid var(--deck-edge-dark);
    box-shadow: inset 0 1px 3px var(--deck-shadow), 0 1px 0 var(--deck-edge-light);
    pointer-events: none;
  }

  .control-bay__screw {
    position: absolute;
    right: 6px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--deck-chrome-hi) 38%, var(--deck-chrome-lo) 42% 58%, var(--deck-chrome-mid) 62%);

    &--1 { top: 6px; }
    &--2 { bottom: 6px; }
  }

  /* Machined aluminum platter + 1:1 scratchable spinning vinyl */
  .deck-well {
    position: absolute;
    top: 16px;
    left: 14px;
    width: 170px;
    height: 170px;
    border-radius: 50%;
    background: var(--deck-well);
    box-shadow: inset 0 3px 8px rgb(0 0 0 / 0.3), 0 0 0 1px var(--deck-border-soft);
    pointer-events: none;
  }

  .platter-stack {
    position: absolute;
    top: 19px;
    left: 17px;
    width: 164px;
    height: 164px;
    transform-style: preserve-3d;
  }

  .platter-rim {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;

    &--1 {
      transform: translateZ(2px);
      background: linear-gradient(145deg, var(--deck-chrome-lo), var(--deck-chrome-mid));
      border: 1px solid var(--deck-border-soft);
    }

    &--2 {
      inset: 1px;
      transform: translateZ(6px);
      background: linear-gradient(145deg, var(--deck-chrome-mid), var(--deck-chrome-lo));
    }

    &--3 {
      inset: 2px;
      transform: translateZ(10px);
      background: linear-gradient(145deg, var(--deck-chrome-hi), var(--deck-chrome-mid));
      box-shadow: inset 0 0 0 2.5px #121213;
    }
  }

  .music-player__platter {
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    transform-style: preserve-3d;
    transform: translateZ(11.5px);
    cursor: grab;
    touch-action: none;

    &:focus-visible {
      outline: 2px solid color(accent);
      outline-offset: 4px;
    }

    &[aria-disabled='true'] {
      cursor: default;
    }
  }

  .is-scrubbing .music-player__platter {
    cursor: grabbing;
  }

  .music-player__cue {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    transform: rotate(var(--cue-angle, 0deg));
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .is-scrubbing .music-player__cue {
    transition: none;
  }

  .music-player__disc {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    clip-path: circle(50% at 50% 50%);
    backface-visibility: hidden;
    background:
      conic-gradient(
        from 15deg,
        transparent 0deg,
        rgb(255 248 235 / 0.16) 38deg,
        transparent 84deg 185deg,
        rgb(255 248 235 / 0.11) 228deg,
        transparent 272deg
      ),
      repeating-radial-gradient(circle, #0b0b0c 0 1px, #262525 1.7px, #111112 2.7px);
    animation: record-spin 3.4s linear infinite paused;

    img {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 40%;
      height: 40%;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      border: 1.5px solid var(--deck-brass);
      object-fit: cover;
      pointer-events: none;
    }
  }

  .is-playing.is-expanded .music-player__disc {
    animation-play-state: running;
  }

  .is-playing.is-expanded.is-scrubbing .music-player__disc {
    animation-play-state: paused;
  }

  .music-player__record-mark {
    position: absolute;
    top: 6px;
    left: 50%;
    z-index: 2;
    width: 2.5px;
    height: 8px;
    transform: translateX(-50%);
    background: var(--deck-brass);
  }

  .music-player__spindle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--deck-chrome-hi), var(--deck-chrome-lo));
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.55);
    transform: translate(-50%, -50%) translateZ(5px);
    pointer-events: none;
  }

  /* Classic front-left chunky Start / Stop 3D button */
  .deck-play {
    position: absolute;
    left: 14px;
    bottom: 12px;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--deck-ink);
    transform-style: preserve-3d;
    cursor: pointer;

    &::after {
      content: '';
      position: absolute;
      inset: -7px;
      border-radius: 50%;
    }

    &:focus-visible {
      outline: 2px solid color(accent);
      outline-offset: 4px;
    }
  }

  .deck-play__base {
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    background: var(--deck-chrome-lo);
    border: 1px solid var(--deck-border-soft);
    transform: translateZ(2px);
    pointer-events: none;
  }

  .deck-play__cap {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 1px solid var(--deck-border);
    background: radial-gradient(circle at 35% 28%, var(--deck-chrome-hi), var(--deck-face-mid));
    box-shadow: 0 3px 6px rgb(0 0 0 / 0.28);
    transform: translateZ(7px);
    transition: transform 180ms ease(out-back), box-shadow 180ms;
  }

  .deck-play:hover .deck-play__cap {
    transform: translateZ(10px) scale(1.09);
    box-shadow: 0 6px 12px rgb(0 0 0 / 0.34);
  }

  .deck-play:active .deck-play__cap,
  .is-playing .deck-play__cap {
    transform: translateZ(3.5px) scale(0.98);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
  }

  .deck-play__led {
    position: absolute;
    top: 3px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--deck-led-off);
    transition: background 180ms, box-shadow 180ms;
  }

  .is-playing .deck-play__led {
    background: var(--deck-led-on);
    box-shadow: 0 0 7px var(--deck-led-glow);
  }

  .deck-play__icon {
    width: 11px;
    height: 11px;
    margin-top: 3px;
    color: var(--deck-ink);
  }

  .deck-play__icon--stop { display: none; }
  .is-playing .deck-play__icon--play { display: none; }
  .is-playing .deck-play__icon--stop { display: block; }

  /* =========================================================
   * TRUE SCULPTED 3D TONEARM ASSEMBLY
   * ========================================================= */
  .tonearm-assembly {
    position: absolute;
    top: 22px;
    right: 40px;
    width: 36px;
    height: 36px;
    transform-style: preserve-3d;
  }

  .tonearm-base {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    pointer-events: none;
    border-radius: 50%;
    box-shadow: 1px 2px 3px var(--deck-shadow);
  }

  .tonearm-base__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--deck-border-soft);

    &--1 {
      transform: translateZ(3px);
      background: linear-gradient(145deg, var(--deck-chrome-lo), var(--deck-well));
    }

    &--2 {
      inset: 3px;
      transform: translateZ(8px);
      background: var(--deck-brush), linear-gradient(145deg, var(--deck-chrome-hi), var(--deck-chrome-mid));
    }

    &--3 {
      inset: 7px;
      transform: translateZ(13px);
      background: linear-gradient(145deg, var(--deck-chrome-mid), var(--deck-chrome-lo));
    }
  }

  /* Vertical gimbal yoke pillars rising beside the pivot */
  .tonearm-base__yoke {
    position: absolute;
    top: 11px;
    width: 14px;
    height: 14px;
    background: linear-gradient(180deg, var(--deck-chrome-hi), var(--deck-chrome-lo));
    border: 1px solid var(--deck-border-soft);
    transform-origin: 50% 50%;

    &--left {
      left: 2px;
      transform: translateZ(18px) rotateY(90deg);
    }

    &--right {
      right: 2px;
      transform: translateZ(18px) rotateY(90deg);
    }
  }

  .tonearm-base__cap {
    position: absolute;
    inset: 10px;
    border-radius: 50%;
    transform: translateZ(22px);
    background: radial-gradient(circle at 35% 30%, var(--deck-chrome-hi), var(--deck-chrome-lo));
    border: 1px solid var(--deck-border);
  }

  /* Anti-skate mini dial beside gimbal */
  .tonearm-antiskate {
    position: absolute;
    top: 24px;
    right: -12px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--deck-chrome-hi), var(--deck-chrome-lo));
    border: 1px solid var(--deck-border);
    transform: translateZ(7px);
  }

  /* 3D U-shaped tonearm cradle rest */
  .tonearm-rest {
    position: absolute;
    top: 58px;
    left: 11px;
    width: 14px;
    height: 10px;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  .tonearm-rest__post {
    position: absolute;
    left: 5px;
    top: 2px;
    width: 4px;
    height: 12px;
    background: linear-gradient(90deg, var(--deck-chrome-lo), var(--deck-chrome-mid));
    transform-origin: 50% 0;
    transform: rotateX(90deg);
  }

  .tonearm-rest__cradle {
    position: absolute;
    inset: 0;
    border: 1.5px solid #1a1b1e;
    border-bottom: 0;
    border-radius: 3px 3px 0 0;
    background: rgb(20 20 22 / 0.85);
    transform: translateZ(12px);
  }

  /* Dynamic projected tonearm shadow */
  .music-player__tonearm-shadow {
    position: absolute;
    top: 18px;
    left: 15px;
    width: 6px;
    height: 102px;
    border-radius: 4px;
    background: rgb(0 0 0 / 0.24);
    filter: blur(3px);
    transform-origin: 50% 0;
    transform: translateZ(1.5px) rotate(4deg);
    transition: transform 360ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 200ms;
    pointer-events: none;
  }

  .is-playing .music-player__tonearm-shadow {
    transform: translateZ(1.5px) rotate(var(--tonearm-angle));
  }

  .is-scrubbing .music-player__tonearm-shadow,
  .is-cueing .music-player__tonearm-shadow {
    opacity: 0.4;
    transform: translateZ(1.5px) rotate(var(--tonearm-angle)) translate(4px, 5px);
  }

  /* Articulated 3D arm (lifted high when parked or scrubbing, lowered to kiss the vinyl when playing) */
  .music-player__tonearm {
    position: absolute;
    top: 18px;
    left: 18px;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: translateZ(20px) rotate(4deg);
    transition: transform 360ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .is-playing .music-player__tonearm {
    transform: translateZ(15px) rotate(var(--tonearm-angle));
  }

  .is-scrubbing .music-player__tonearm,
  .is-cueing .music-player__tonearm {
    transform: translateZ(23px) rotate(var(--tonearm-angle));
  }

  .is-scrubbing .music-player__tonearm,
  .is-scrubbing .music-player__tonearm-shadow {
    transition: none;
  }

  .tonearm__weight,
  .tonearm__rod {
    position: absolute;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  .tonearm__weight {
    --tube-radius: 8px;
    top: -25px;
    left: -8px;
    width: 16px;
    height: 19px;
  }

  .tonearm__rod {
    --tube-radius: 2.5px;
    top: -7px;
    left: -2.5px;
    width: 5px;
    height: 93px;
  }

  .tonearm__facet {
    position: absolute;
    inset: 0 auto 0 50%;
